{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:automerge",
    "github>Netcracker/renovate-config:apm"
  ],
  "customManagers": [
    {
      "description": "Update the Python runtime used by uv commands.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/\\.sh$/",
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\buvx?\\s+(?:[^\\s|;&]+\\s+)*?(?:--python|-p)[\\s=]+(?<currentValue>\\d+(?:\\.\\d+)+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ],
  "packageRules": [
    {
      "description": "Keep CI Python tools from requirements.txt grouped together, and open their pull request outside the weekly schedule, so an update arrives once it passes the inherited release-age delay instead of on the next Monday after that.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements.txt"
      ],
      "groupName": "python ci tools",
      "schedule": [
        "at any time"
      ]
    }
  ]
}
