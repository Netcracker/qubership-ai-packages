{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:automerge",
    "github>Netcracker/renovate-config:apm"
  ],
  "customManagers": [
    {
      "description": "Update the Python runtime used by uv commands.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/\\.sh$/",
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\buvx?\\s+(?:[^\\s|;&]+\\s+)*?(?:--python|-p)[\\s=]+(?<currentValue>\\d+(?:\\.\\d+)+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    },
    {
      "description": "Update the tools a test-authoring probe pins in its probe.sh behind a `# renovate:` comment.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^research/test-authoring/probes/[^/]+/probe\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep CI Python tools from requirements.txt grouped together.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements.txt"
      ],
      "groupName": "python ci tools"
    },
    {
      "description": "Stryker's TypeScript checker crashes on TypeScript 7 (ts.parseConfigFileTextToJson is gone); hold the mutation probe on TypeScript 6.",
      "matchFileNames": [
        "research/test-authoring/probes/javascript-mutation-stryker/package.json"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "The java-junit5 probe measures the last JUnit 5 release; java-junit6 follows the current major.",
      "matchFileNames": [
        "research/test-authoring/probes/java-junit5/pom.xml"
      ],
      "matchPackageNames": [
        "org.junit:junit-bom"
      ],
      "allowedVersions": "<6"
    }
  ]
}
