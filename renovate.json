{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:automerge",
    "github>Netcracker/renovate-config:apm"
  ],
  "customManagers": [
    {
      "description": "Update the Python runtime used by uv commands.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/",
        "/\\.sh$/",
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\buvx?\\s+(?:[^\\s|;&]+\\s+)*?(?:--python|-p)[\\s=]+(?<currentValue>\\d+(?:\\.\\d+)+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ],
  "packageRules": [
    {
      "description": "Keep CI Python tools from requirements.txt grouped together.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements.txt"
      ],
      "groupName": "python ci tools"
    },
    {
      "description": "Leave package dependencies to the built-in apm manager, which updates the SHA and the tag of #<sha>  # <tag> together. The shared apm preset's regex manager matches the same lines and writes #<new tag>, dropping the SHA that tests/marketplace_roundtrip.sh requires.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "agent-packages/*/apm.yml"
      ],
      "enabled": false
    }
  ]
}
