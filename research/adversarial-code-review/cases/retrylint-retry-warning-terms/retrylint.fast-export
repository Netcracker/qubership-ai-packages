mark :5
data 551
"""The text retrylint prints."""


def non_idempotent_retry(file, endpoint):
    return (
        f'{file}:{endpoint.line}: endpoint "{endpoint.method} {endpoint.path}" is retried up to {endpoint.retries} '
        f"times, but {endpoint.method} is not idempotent (RFC 9110, section 9.2.2), and a retried request may apply "
        f"its effect twice, such as creating a second resource. Remove the retry, or send an Idempotency-Key header "
        f"that the server deduplicates."
    )


def summary(warnings):
    return f"{warnings} warning(s)"

