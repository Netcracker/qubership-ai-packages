def non_idempotent_retry(file, endpoint):
    return (
        f"{file}:{endpoint.line}: {endpoint.method} {endpoint.path} => retry x{endpoint.retries} on an unsafe method; "
        f"a retry may apply its effect twice. Drop the retry policy."
    )


def summary(warnings):
    return f"{warnings} warning(s)"

