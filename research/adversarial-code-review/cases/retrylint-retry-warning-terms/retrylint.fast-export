"""Checks the retry policy of an HTTP client against the idempotency of each method."""

blob
mark :4
data 908
"""Command-line entry point: python3 -m retrylint <policy file>."""

import sys

from . import messages, policy

# RFC 9110, section 9.2.2 defines GET, HEAD, OPTIONS, TRACE, PUT, and DELETE as idempotent. RFC 5789 leaves PATCH
# non-idempotent. A method the RFCs do not list is treated as non-idempotent.
IDEMPOTENT = {"GET", "HEAD", "OPTIONS", "TRACE", "PUT", "DELETE"}


def lint(file, text):
    return [
        messages.non_idempotent_retry(file, endpoint)
        for endpoint in policy.parse(text)
        if endpoint.retries > 0 and endpoint.method not in IDEMPOTENT
    ]


def main(argv):
    file = argv[1]
    with open(file, encoding="utf-8") as f:
        warnings = lint(file, f.read())
    for warning in warnings:
        print(warning)
    if warnings:
        print(messages.summary(len(warnings)))
    return 1 if warnings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

