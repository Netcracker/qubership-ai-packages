"""Compares the output of retrylint on each policy file under golden/ with the .txt file of the same name."""

import contextlib
import io
import pathlib
import unittest

from retrylint.__main__ import main

GOLDEN = pathlib.Path(__file__).parent / "golden"


class GoldenTest(unittest.TestCase):
    def test_golden(self):
        for conf in sorted(GOLDEN.glob("*.conf")):
            with self.subTest(conf.name):
                out = io.StringIO()
                with contextlib.redirect_stdout(out):
                    main(["retrylint", str(conf.relative_to(GOLDEN.parent.parent))])
                self.assertEqual(conf.with_suffix(".txt").read_text(encoding="utf-8"), out.getvalue())

