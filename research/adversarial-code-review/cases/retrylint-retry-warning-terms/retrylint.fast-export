mark :6
data 611
"""Reads a retry policy file."""

from dataclasses import dataclass


@dataclass(frozen=True)
class Endpoint:
    line: int
    method: str
    path: str
    retries: int


def parse(text):
    """Returns the endpoints of a policy file, skipping blank lines and lines that start with '#'."""
    endpoints = []
    for number, raw in enumerate(text.splitlines(), start=1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        method, path, retries = line.split()
        endpoints.append(Endpoint(number, method.upper(), path, int(retries)))
    return endpoints

