+                take(box);
+              }
+              <T extends Object> void nonNullBound(Box<T> box) {
+                take(box);
+              }
+              <T extends @Nullable Object> void nonNullUse(Box<@NonNull T> box) {
+                take(box);
+              }
+            }
+            """)
+        .doTest();
+  }
