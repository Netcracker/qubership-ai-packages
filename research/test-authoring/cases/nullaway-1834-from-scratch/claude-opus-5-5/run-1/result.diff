+  @Test
+  public void typeVariableIsRejectedByNonNullExtendsWildcardOnlyWhenItsBoundAdmitsNull() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Box<E extends @Nullable Object> {}
+              void take(Box<? extends Object> box) {}
+              void takeNullable(Box<? extends @Nullable Object> box) {}
+              <T extends @Nullable Object, U> void test(
+                  Box<T> nullableBound, Box<U> nonNullBound, Box<@NonNull T> nonNullUse) {
+                // BUG: Diagnostic contains: incompatible types: Test.Box<T> cannot be converted to Test.Box<? extends Object>
+                take(nullableBound);
+                take(nonNullBound);
+                take(nonNullUse);
+                takeNullable(nullableBound);
+              }
+            }
+            """)
+        .doTest();
+  }
