+                  Box<T> nullableBound, Box<U> nonNullBound, Box<@NonNull T> nonNullUse) {
+                // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                takesNonNull(nullableBound);
+                takesNonNull(nonNullBound);
+                takesNonNull(nonNullUse);
+                takesNullable(nullableBound);
+              }
+            }
+            """)
+        .doTest();
