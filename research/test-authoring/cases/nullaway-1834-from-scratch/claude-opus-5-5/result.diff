+  @Test
+  public void typeVariableArgumentMeetsNonNullWildcardOnlyWhenItsBoundExcludesNull() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Foo<T extends @Nullable Object> {}
+              void nonnullWildcard(Foo<? extends Object> foo) {}
+              <N extends @Nullable Object, M> void test(
+                  Foo<N> nullableBound, Foo<M> nonnullBound, Foo<@NonNull N> nonnullUse) {
+                // BUG: Diagnostic contains: incompatible types: Test.Foo<N> cannot be converted to Test.Foo<? extends Object>
+                nonnullWildcard(nullableBound);
+                nonnullWildcard(nonnullBound);
+                nonnullWildcard(nonnullUse);
+              }
+            }
+            """)
+        .doTest();
+  }
