+  @Test
+  public void typeVariableArgumentIsRejectedByNonNullWildcardOnlyWhenItsBoundAdmitsNull() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              static class Box<T extends @Nullable Object> {}
+              static void take(Box<? extends Object> box) {}
+              static <T extends @Nullable Object> void nullableBound(Box<T> box, Box<@NonNull T> nonNullUse) {
+                // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                take(box);
+                // legal since @NonNull at the use site overrides the bound
+                take(nonNullUse);
+              }
+              static <T> void nonNullBound(Box<T> box) {
+                // legal since the bound of T excludes null
+                take(box);
+              }
+            }
+            """)
+        .doTest();
+  }
