+  public void extendsWildcardOfAConcreteBoundRejectsAnActualAdmittingNullViaItsDeclaredBound() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              interface Box<T extends @Nullable Object> {}
+              static void takeNonNull(Box<? extends Object> box) {}
+              static <T extends @Nullable Object> void testDirectActualWithNullableBound(Box<T> box) {
+                // BUG: Diagnostic contains: incompatible types
+                takeNonNull(box);
+              }
+              static <T extends Object> void testDirectActualWithNonNullBound(Box<T> box) {
+                takeNonNull(box);
+              }
+              static <T extends @Nullable Object> void testWildcardActualNamingNullableBoundTypeVariable(
+                  Box<? extends T> box) {
+                // BUG: Diagnostic contains: incompatible types
+                takeNonNull(box);
+              }
+              static <T extends Object> void testWildcardActualNamingNonNullBoundTypeVariable(
+                  Box<? extends T> box) {
+                takeNonNull(box);
+              }
+            }
+            """)
+        .doTest();
+  }
