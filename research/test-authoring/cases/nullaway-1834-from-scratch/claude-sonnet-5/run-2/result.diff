+  @Test
+  public void parametricExtendsWildcardRejectsNullableActualBoundOnlyWhenTargetCannotBeNull() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              interface Box<T extends @Nullable Object> {}
+              static class NonNullTarget<T> {
+                void consume(Box<? extends T> box) {}
+                <S extends T> void testNegative(Box<S> box) {
+                  consume(box);
+                }
+                <S extends @Nullable T> void testPositive(Box<S> box) {
+                  // BUG: Diagnostic contains: incompatible types
+                  consume(box);
+                }
+              }
+              static class NullableTarget<T extends @Nullable Object> {
+                void consume(Box<? extends T> box) {}
+                <S extends @Nullable T> void testNegative(Box<S> box) {
+                  consume(box);
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
