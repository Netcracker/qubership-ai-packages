+  @Test
+  public void extendsWildcardNamingATypeVariableComparesActualAsWritten() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Foo<X extends @Nullable Object> {}
+              // same type variable on both sides: legal however T is bounded
+              <T> void testSameTypeVariable(Foo<T> f) {
+                Foo<? extends T> ok = f;
+              }
+              // S's bound is T, so S cannot be null since T itself cannot be null
+              <T, S extends T> void testNegative(Foo<S> f) {
+                Foo<? extends T> ok = f;
+              }
+              // S admits null while the required T cannot, even though both name T
+              <T, S extends @Nullable T> void testPositive(Foo<S> f) {
+                // BUG: Diagnostic contains: incompatible types: Test.Foo<S> cannot be converted to Test.Foo<? extends T>
+                Foo<? extends T> bad = f;
+              }
+            }
+            """)
+        .doTest();
+  }
