+  @Test
+  public void bareTypeVariableActualRejectedWhenItsBoundAdmitsNull() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              static class Box<T extends @Nullable Object> {}
+              static void nonnullWildcard(Box<? extends Object> box) {}
+              static <T extends @Nullable Object> void testPositive(Box<T> box) {
+                // BUG: Diagnostic contains: incompatible types
+                nonnullWildcard(box);
+              }
+              static <T> void testNegative(Box<T> box) {
+                nonnullWildcard(box);
+              }
+            }
+            """)
+        .doTest();
+  }
