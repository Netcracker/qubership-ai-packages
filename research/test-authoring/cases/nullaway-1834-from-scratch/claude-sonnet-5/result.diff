+  @Test
+  public void aParametricWildcardBoundRejectsAnActualWhoseBoundAdmitsNullWhileItsOwnDoesNot() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Foo<T extends @Nullable Object> {}
+              class Sink<T extends @Nullable Object> {
+                void accept(Foo<? extends T> foo) {}
+              }
+              // Foo<T> and Foo<S extends T> stay assignable to a Sink<T>, whatever T is, since the
+              // formal admits whatever T is instantiated as.
+              <T extends @Nullable Object> void fromSameTypeVar(Sink<T> sink, Foo<T> foo) {
+                sink.accept(foo);
+              }
+              <T extends @Nullable Object, S extends T> void fromSubtype(Sink<T> sink, Foo<S> foo) {
+                sink.accept(foo);
+              }
+              // A Foo<S> with S extends @Nullable T holds a null a Sink<T> may not accept when T
+              // itself cannot be null.
+              <T, S extends @Nullable T> void fromNullableSubBoundNonNullT(Sink<T> sink, Foo<S> foo) {
+                // BUG: Diagnostic contains: incompatible types
+                sink.accept(foo);
+              }
+              // The same Foo<S> is accepted once the Sink's own T admits null too.
+              <T extends @Nullable Object, S extends @Nullable T> void fromNullableSubBoundNullableT(
+                  Sink<T> sink, Foo<S> foo) {
+                sink.accept(foo);
+              }
+            }
+            """)
+        .doTest();
+  }
