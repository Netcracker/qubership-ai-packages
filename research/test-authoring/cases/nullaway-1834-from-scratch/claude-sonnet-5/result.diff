+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              interface Box<T extends @Nullable Object> {}
+              static void acceptNonNull(Box<? extends Object> box) {}
+              static <T> void testNonNullBound(Box<T> box) {
+                acceptNonNull(box);
+              }
+              static <T extends @Nullable Object> void testNullableBound(Box<T> box) {
+                // BUG: Diagnostic contains: incompatible types
+                acceptNonNull(box);
+              }
+              static <T extends @Nullable Object> void testNullableBoundViaWildcardActual(
+                  Box<? extends T> box) {
+                // BUG: Diagnostic contains: incompatible types
+                acceptNonNull(box);
+              }
+            }
+            """)
+        .doTest();
+  }
