+  @Test
+  public void typeVariableActualWithNullableBoundRejectedByNonNullExtendsWildcard() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              static class Box<T extends @Nullable Object> {}
+              static <N extends @Nullable Object, O> void test(
+                  Box<N> nullableBoundBox, Box<O> nonNullBoundBox) {
+                // BUG: Diagnostic contains: incompatible types: Box<N> cannot be converted to Box<? extends Object>
+                Box<? extends Object> bad = nullableBoundBox;
+                Box<? extends Object> ok = nonNullBoundBox;
+              }
+            }
+            """)
+        .doTest();
+  }
+
+  @Test
+  public void explicitlyNonNullAnnotatedTypeVariableActualIsComparedAsWritten() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              static class Box<T extends @Nullable Object> {}
+              // the bound of N admits null, but the explicit @NonNull on the actual argument
+              // overrides it
+              static <N extends @Nullable Object> void test(Box<@NonNull N> nonNullBoxOfN) {
+                Box<? extends Object> ok = nonNullBoxOfN;
+              }
+            }
+            """)
+        .doTest();
+  }
