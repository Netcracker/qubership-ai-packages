+            "Test.java",
+            """
+            package com.uber;
+            import java.util.List;
+            import org.jspecify.annotations.NonNull;
+            import org.jspecify.annotations.Nullable;
+            class Test {
+              interface Base<V extends @Nullable Object> {
+                List<? extends @NonNull V> get();
+              }
+              // V itself cannot be null here, so a bare List<V> satisfies List<? extends @NonNull V>
+              static class NonNullBound<V> implements Base<V> {
+                @Override
+                public List<V> get() { throw new AssertionError(); }
+              }
+              // V admits null here, so List<V> can hold a null that List<? extends @NonNull V> may not
+              static class NullableBound<V extends @Nullable Object> implements Base<V> {
+                @Override
+                // BUG: Diagnostic contains: mismatched type parameter nullability
+                public List<V> get() { throw new AssertionError(); }
+              }
+            }
+            """)
+        .doTest();
+  }
