+  @Test
+  public void bareTypeVariableActualIsJudgedByItsDeclaredBound() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Box<V extends @Nullable Object> {}
+              void nonnullWildcard(Box<? extends Object> box) {}
+              <T extends @Nullable Object> void testPositive(Box<T> box) {
+                // a bare T with a @Nullable-admitting bound holds a null the formal rejects
+                // BUG: Diagnostic contains: incompatible types: Test.Box<T> cannot be converted to Test.Box<? extends Object>
+                nonnullWildcard(box);
+              }
+              <T> void testNegative(Box<T> box) {
+                // T's declared bound cannot be null, so this is legal
+                nonnullWildcard(box);
+              }
+            }
+            """)
+        .doTest();
+  }
+
+  @Test
+  public void parametricExtendsWildcardComparesDeclaredBoundsNotNames() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Box<V extends @Nullable Object> {}
+              class Container<T, NullableSub extends @Nullable T, NonNullSub extends T> {
+                void nonnullWildcard(Box<? extends T> box) {}
+                void testNegativeSameTypeVariable(Box<T> box) {
+                  // Box<T> stays assignable to Box<? extends T>, whatever T is instantiated as
+                  nonnullWildcard(box);
+                }
+                void testNegativeNonNullSubBound(Box<NonNullSub> box) {
+                  // NonNullSub's bound is T itself, so it holds nothing T could not
+                  nonnullWildcard(box);
+                }
+                void testPositive(Box<NullableSub> box) {
+                  // NullableSub may be null while T may not, however the two names relate
+                  // BUG: Diagnostic contains: incompatible types: Test.Box<NullableSub> cannot be converted to Test.Box<? extends T>
+                  nonnullWildcard(box);
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
+
+  @Test
+  public void explicitNonNullWildcardBoundRejectsSameBareTypeVariable() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.*;
+            @NullMarked
+            class Test {
+              class Box<V extends @Nullable Object> {}
+              class Container<T extends @Nullable Object> {
+                void nonNullTWildcard(Box<? extends @NonNull T> box) {}
+                void testPositive(Box<T> box) {
+                  // T admits null at its declaration; the wildcard's own @NonNull overrides that
+                  // BUG: Diagnostic contains: incompatible types: Test.Box<T> cannot be converted to Test.Box<? extends T>
+                  nonNullTWildcard(box);
+                }
+                void testNegative(Box<@NonNull T> box) {
+                  // written @NonNull on the actual matches the wildcard's own @NonNull
+                  nonNullTWildcard(box);
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
+
