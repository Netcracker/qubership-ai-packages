 # `helm test` runs the suite Job of the test stand and exits with its outcome.
 # It prints the log only at the end, so the log is streamed while it runs.
-# `kubectl logs -f` fails at once while the container is still being created,
-# so the loop polls for up to three minutes until the log can be read.
+# `kubectl logs` fails until the Job exists and its container has started, so
+# the loop polls for up to three minutes. A container that has not started by
+# then, for example on ErrImageNeverPull, will not: the target prints the Pod
+# and stops helm test rather than wait out its timeout.
 # $(1) is kubectl, $(2) is helm, $(3) is the Job name, $(4) is how long helm
 # waits for the Job, no shorter than its suite.activeDeadlineSeconds.
 define run-suite
 $(1) delete job $(3) --ignore-not-found --wait
 $(2) test authz-test-stand --timeout $(4) & helm_pid=$$!; \
-	$(1) wait --for=create job/$(3) --timeout=2m \
-	&& for i in $$(seq 90); do $(1) logs job/$(3) >/dev/null 2>&1 && break; sleep 2; done; \
+	started=; for i in $$(seq 90); do $(1) logs job/$(3) >/dev/null 2>&1 && { started=1; break; }; sleep 2; done; \
+	if [ -z "$$started" ]; then \
+		echo "The $(3) container did not start within 3 minutes:"; \
+		$(1) get pods -l job-name=$(3) -o wide; \
+		kill $$helm_pid; wait $$helm_pid; exit 1; \
+	fi; \
 	$(1) logs -f job/$(3); \
 	wait $$helm_pid
 endef
