@@ -0,0 +1,78 @@
+#!/usr/bin/env bash
+
+# Copyright 2024-2026 Netcracker Technology Corporation
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# The helm of test-suite-targets.sh. Each call is appended to
+# $FAKE_STATE/helm.calls, and every command but `test` succeeds at once.
+#
+# `helm test` waits for the suite Job as Helm does: it exits with
+# FAKE_SUITE_STATUS, 0 by default, once the fake kubectl has streamed the suite
+# log to its end, and fails once the fake clock reaches its --timeout, which it
+# writes to $FAKE_STATE/helm-test.timeout. When it is stopped, it writes
+# $FAKE_STATE/helm-test.killed, and when it exits, $FAKE_STATE/helm-test.exited.
+#
+# A clock that stands still for two real seconds means that nothing but helm
+# test is left running, as when the target waits for it, and the cluster's own
+# time passes: a container of FAKE_POD starts-on-poll starts and the suite
+# succeeds, any other runs helm test out of its timeout.
+set -euo pipefail
+
+state="${FAKE_STATE:?}"
+echo "$*" >>"${state}/helm.calls"
+
+[[ " $* " == *" test "* ]] || exit 0
+
+timeout=300
+while (($# > 0)); do
+  if [[ "$1" == --timeout ]]; then
+    case "$2" in
+      *m) timeout=$((${2%m} * 60)) ;;
+      *s) timeout="${2%s}" ;;
+    esac
+  fi
+  shift
+done
+
+echo "${timeout}" >"${state}/helm-test.timeout"
+trap 'touch "${state}/helm-test.exited"' EXIT
+trap 'touch "${state}/helm-test.killed"; exit 143' TERM
+
+succeed() {
+  echo 'Phase:          Succeeded'
+  exit "${FAKE_SUITE_STATUS:-0}"
+}
+
+time_out() {
+  echo 'Error: timed out waiting for the condition' >&2
+  exit 1
+}
+
+last_clock=-1
+SECONDS=0
+while :; do
+  [[ -e "${state}/suite-finished" ]] && succeed
+  clock="$(<"${state}/clock")"
+  ((clock >= timeout)) && time_out
+  if ((clock != last_clock)); then
+    last_clock="${clock}"
+    SECONDS=0
+  elif ((SECONDS >= 2)); then
+    [[ "${FAKE_POD}" == starts-on-poll:* ]] && succeed
+    echo "${timeout}" >"${state}/clock.new"
+    mv "${state}/clock.new" "${state}/clock"
+    time_out
+  fi
+  /bin/sleep 0.05
+done
diff --git a/test/scripts/fake-cluster/kubectl b/test/scripts/fake-cluster/kubectl
