+++ b/test/scripts/fake-cluster/kubectl
@@ -0,0 +1,126 @@
+#!/usr/bin/env bash
+
+# Copyright 2024-2026 Netcracker Technology Corporation
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# The kubectl of test-suite-targets.sh: a namespace that holds one suite Job,
+# answering the calls of the suite targets the way kubectl 1.35 does. Each call
+# is appended to $FAKE_STATE/kubectl.calls.
+#
+#   FAKE_NAMESPACE, FAKE_JOB  the namespace and the name of the Job
+#   FAKE_POD                  starts-on-poll:N   the container has started by
+#                                                the Nth `kubectl logs`
+#                             ErrImageNeverPull  the container never starts
+#                             none               the Job has no Pod, as when
+#                                                admission refuses it
+#   FAKE_WAIT_FOR_CREATE      unsupported: `wait --for=create` is refused, as
+#                             kubectl before 1.31 refuses it
+set -euo pipefail
+
+state="${FAKE_STATE:?}"
+namespace=
+args=()
+while (($# > 0)); do
+  case "$1" in
+    --context) shift 2 ;;
+    -n) namespace="$2"; shift 2 ;;
+    *) args+=("$1"); shift ;;
+  esac
+done
+echo "${args[*]}" >>"${state}/kubectl.calls"
+
+pod="${FAKE_JOB}-7tq2m"
+
+advance_clock() {
+  echo $(($(<"${state}/clock") + $1)) >"${state}/clock.new"
+  mv "${state}/clock.new" "${state}/clock"
+}
+
+seconds_of() {
+  case "$1" in
+    *m) echo $((${1%m} * 60)) ;;
+    *s) echo "${1%s}" ;;
+  esac
+}
+
+# Counts this call of `kubectl logs` and tells whether the container has
+# started by it.
+container_started() {
+  local polls
+  polls=$(($(cat "${state}/polls" 2>/dev/null || echo 0) + 1))
+  echo "${polls}" >"${state}/polls"
+  [[ "${FAKE_POD}" == starts-on-poll:* ]] && ((polls >= ${FAKE_POD#starts-on-poll:}))
+}
+
+case "${args[0]}" in
+  delete) ;;
+  wait)
+    if [[ "${FAKE_WAIT_FOR_CREATE:-}" == unsupported ]]; then
+      echo 'error: unrecognized condition: "create"' >&2
+      exit 1
+    fi
+    ;;
+  logs)
+    follow=
+    job=
+    pod_running_timeout=20
+    for arg in "${args[@]:1}"; do
+      case "${arg}" in
+        -f) follow=1 ;;
+        job/*) job="${arg#job/}" ;;
+        --pod-running-timeout=*) pod_running_timeout="$(seconds_of "${arg#*=}")" ;;
+      esac
+    done
+    if [[ "${namespace}" != "${FAKE_NAMESPACE}" || "${job}" != "${FAKE_JOB}" ]]; then
+      echo "Error from server (NotFound): jobs.batch \"${job}\" not found" >&2
+      exit 1
+    fi
+    if [[ "${FAKE_POD}" == none ]]; then
+      # kubectl waits --pod-running-timeout for the Job's first Pod:
+      # k8s.io/kubectl/pkg/polymorphichelpers/helpers.go, GetPodList.
+      advance_clock "${pod_running_timeout}"
+      echo 'error: timed out waiting for the condition' >&2
+      exit 1
+    fi
+    if ! container_started; then
+      reason=ContainerCreating
+      [[ "${FAKE_POD}" == ErrImageNeverPull ]] && reason=ErrImageNeverPull
+      echo "Error from server (BadRequest): container \"suite\" in pod \"${pod}\" is waiting to start: ${reason}" >&2
+      exit 1
+    fi
+    echo '--- PASS: TestSuite (0.01s)'
+    if [[ -n "${follow}" ]]; then
+      touch "${state}/suite-finished"
+    fi
+    ;;
+  get)
+    selector=
+    for ((i = 1; i < ${#args[@]}; i++)); do
+      [[ "${args[i]}" == -l ]] && selector="${args[i + 1]}"
+    done
+    if [[ "${namespace}" == "${FAKE_NAMESPACE}" && "${selector}" == "job-name=${FAKE_JOB}" && "${FAKE_POD}" != none ]]; then
+      status=ContainerCreating
+      [[ "${FAKE_POD}" == ErrImageNeverPull ]] && status=ErrImageNeverPull
+      printf '%-20s %-6s %-18s %-9s %-4s %-12s %s\n' \
+        NAME READY STATUS RESTARTS AGE IP NODE \
+        "${pod}" 0/1 "${status}" 0 3m 10.244.0.12 authz-e2e-control-plane
+    else
+      echo "No resources found in ${namespace} namespace." >&2
+    fi
+    ;;
+  *)
+    echo "fake kubectl: unexpected call: ${args[*]}" >&2
+    exit 2
+    ;;
+esac
