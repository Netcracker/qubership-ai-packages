+#!/usr/bin/env bash
+
+# Copyright 2024-2026 Netcracker Technology Corporation
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Assertions for the find|sort|xargs|jq pipeline of the chart-files stage in
+# build/authz-agent-transfer/Dockerfile, which merges the user files of
+# test/parity/suite/testdata/realm/ into the parity realm. The pipeline used
+# to pass $(find users -name '*.json') unquoted as jq's file arguments: find's
+# order is whatever the filesystem happens to return, so the merged users, and
+# the realm checksum a chart-files rebuild computed from them, could change
+# between builds with no change to any file, and a file name with a space
+# split into two bad arguments. It now pipes the files through
+# `sort -z | xargs -0`, NUL-separated, which this script holds fixed and
+# checks by running the exact pipeline text, read out of the Dockerfile so it
+# cannot drift from what the image actually runs.
+#
+# There is no Docker in this environment, so the pipeline runs directly under
+# a fake $HOME holding profile.jq as the ~/.jq jq loads on every invocation
+# the same way /root/.jq does in the image, against a users/ directory this
+# script controls.
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+DOCKERFILE="${ROOT_DIR}/build/authz-agent-transfer/Dockerfile"
+PROFILE_JQ="${ROOT_DIR}/build/authz-agent-transfer/profile.jq"
+
+failures=0
+
+fail() {
+  echo "FAIL: $*" >&2
+  failures=$((failures + 1))
+}
+
+pass() {
+  echo "ok: $*"
+}
+
+merge_snippet="$(sed -n "/^ && find users -name '\\*\\.json' -print0/,/^      parity\\/parity-realm\\.json > /p" "${DOCKERFILE}")"
+if [[ -z "${merge_snippet}" ]]; then
+  fail "could not find the find|sort|xargs|jq merge pipeline in ${DOCKERFILE}; has it moved or been reworded?"
+  echo
+  echo "parity users merge checks: ${failures} failure(s)"
+  exit 1
+fi
+# Drop the leading "&&" continuation and the trailing line-continuation
+# backslash (command substitution already strips the newline that used to
+# follow it, so a bare "\" would otherwise reach jq as a stray file argument)
+# so the extracted text parses on its own.
+merge_snippet="$(sed -E '1s/^ *&& *//; $s/[[:space:]]*\\$//' <<<"${merge_snippet}")"
+
+WORKDIR="$(mktemp -d)"
+trap 'rm -rf "${WORKDIR}"' EXIT
+
+# Runs the extracted pipeline against a sandbox users/ directory and prints
+# the merged realm. $1 names the sandbox subdirectory (kept so each case's
+# files are inspectable on failure); the caller has already populated
+# "${WORKDIR}/$1/users/".
+run_merge() {
+  local case_dir="${WORKDIR}/$1"
+  local out_file="${case_dir}/parity-realm.json"
+  local snippet="${merge_snippet//\/out\/realms\/parity\/parity-realm.json/${out_file}}"
+  mkdir -p "${case_dir}/parity"
+  printf '{"users": []}\n' >"${case_dir}/parity/parity-realm.json"
+  cp "${PROFILE_JQ}" "${case_dir}/.jq"
+  if ! (cd "${case_dir}" && HOME="${case_dir}" bash -c "${snippet}") >/dev/null 2>"${case_dir}/stderr"; then
+    echo "pipeline failed for case $1: $(cat "${case_dir}/stderr")" >&2
+    echo '{}'
+    return
+  fi
+  cat "${out_file}"
+}
+
+# ── A file name with a space ─────────────────────────────────────────────
+#
+# The old `$(find ...)` word-split "a space.json" into "a" and "space.json",
+# which jq then refused to open; both users were still meant to be merged.
+space_case="space-in-name"
+mkdir -p "${WORKDIR}/${space_case}/users"
+printf '[{"username":"parity-zed-user"}]\n' >"${WORKDIR}/${space_case}/users/b.json"
+printf '[{"username":"parity-alpha-user","firstName":"Custom"}]\n' >"${WORKDIR}/${space_case}/users/a space.json"
+
+merged="$(run_merge "${space_case}")"
+got_order="$(jq -r '[.users[].username] | join(",")' <<<"${merged}")"
+if [[ "${got_order}" == "parity-alpha-user,parity-zed-user" ]]; then
+  pass "a user file whose name has a space is merged, in filename order"
+else
+  fail "expected users parity-alpha-user,parity-zed-user (in that order), got ${got_order}: ${merged}"
+fi
+if [[ "$(jq -r '.users[0].firstName' <<<"${merged}")" == "Custom" ]]; then
+  pass "a first name the file already sets survives the merge"
+else
+  fail "expected the fixture's firstName 'Custom' to survive, got: ${merged}"
+fi
+if [[ "$(jq -r '.users[1].lastName' <<<"${merged}")" == "ZedUser" ]]; then
+  pass "a first or last name the file omits is filled in from the username"
+else
+  fail "expected lastName 'ZedUser' derived from parity-zed-user, got: ${merged}"
+fi
+
+# ── Merge order does not depend on the order the files were created in ───
+#
+# find has no defined order of its own; only `sort -z` makes it filename
+# order. The files below are created out of alphabetical order, so a merge
+# that read find's raw order would be as likely to get this wrong as right.
+order_case="creation-order"
+mkdir -p "${WORKDIR}/${order_case}/users"
+for letter in d b e a c; do
+  printf '[{"username":"parity-%s-user"}]\n' "${letter}" >"${WORKDIR}/${order_case}/users/${letter}.json"
+done
+merged_order="$(jq -r '[.users[].username] | join(",")' <<<"$(run_merge "${order_case}")")"
+if [[ "${merged_order}" == "parity-a-user,parity-b-user,parity-c-user,parity-d-user,parity-e-user" ]]; then
+  pass "users merge in filename order regardless of the order the files were created in"
+else
+  fail "expected the merge in filename order a,b,c,d,e; got ${merged_order}"
+fi
+
+# ── An empty users directory merges no one, rather than failing ──────────
+#
+# test/parity/suite/testdata/realm/ currently holds no *.json file (only its
+# README), so `xargs -r` has to see this case: cat is not invoked with zero
+# files, and jq reads an empty $users list rather than erroring on malformed
+# input.
+empty_case="no-user-files"
+mkdir -p "${WORKDIR}/${empty_case}/users"
+merged_empty="$(run_merge "${empty_case}")"
+if [[ "$(jq -c '.users' <<<"${merged_empty}")" == "[]" ]]; then
+  pass "an empty users directory (the current state of testdata/realm/) merges in no users and does not fail"
+else
+  fail "expected no users merged from an empty directory, got: ${merged_empty}"
+fi
+
+# ── The merge is deterministic ────────────────────────────────────────────
+#
+# The same inputs, read twice, must give byte-identical output: this is what
+# keeps the Keycloak checksum, and the restart it triggers, from moving
+# between builds that changed nothing.
+first_run="$(run_merge "${order_case}")"
+second_run="$(run_merge "${order_case}")"
+if [[ "${first_run}" == "${second_run}" ]]; then
+  pass "merging the same users twice gives byte-identical output"
+else
+  fail "two merges of the same users differ: $(diff <(echo "${first_run}") <(echo "${second_run}") || true)"
+fi
+
+echo
+if ((failures > 0)); then
+  echo "parity users merge checks: ${failures} failure(s)"
+  exit 1
+fi
+
+echo "parity users merge checks: all passed"
