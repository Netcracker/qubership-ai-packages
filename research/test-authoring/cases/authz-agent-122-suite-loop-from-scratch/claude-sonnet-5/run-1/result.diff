@@ -0,0 +1,158 @@
+#!/usr/bin/env bash
+
+# Copyright 2024-2026 Netcracker Technology Corporation
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+# Assertions for the parity-realm merge the chart-files stage of
+# build/authz-agent-transfer/Dockerfile runs: the jq pipeline that folds the
+# users/*.json files into parity/parity-realm.json. No Docker build is
+# involved; the pipeline is plain jq and shell, so it runs directly against a
+# fixture directory on the local machine.
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+DOCKERFILE="${ROOT_DIR}/build/authz-agent-transfer/Dockerfile"
+PROFILE_JQ="${ROOT_DIR}/build/authz-agent-transfer/profile.jq"
+
+require_cmd() {
+  if ! command -v "$1" >/dev/null 2>&1; then
+    echo "error: required command not found: $1" >&2
+    exit 1
+  fi
+}
+
+require_cmd jq
+require_cmd sort
+require_cmd xargs
+require_cmd find
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "${WORK}"' EXIT
+mkdir -p "${WORK}/home" "${WORK}/parity" "${WORK}/users"
+# jq reads a "def"-only file named .jq in $HOME before running the program it
+# is given, the same way the Dockerfile's RUN step reads it from /root/.jq;
+# this is how the pipeline's "profile" call resolves.
+cp "${PROFILE_JQ}" "${WORK}/home/.jq"
+export HOME="${WORK}/home"
+
+cat >"${WORK}/parity/parity-realm.json" <<'JSON'
+{"realm": "parity", "users": [{"username": "seed-user", "firstName": "Seed", "lastName": "User", "email": "seed-user@example.test"}]}
+JSON
+
+failures=0
+fail() {
+  echo "FAIL: $*" >&2
+  failures=$((failures + 1))
+}
+pass() {
+  echo "ok: $*"
+}
+
+# The exact shell pipeline of the Dockerfile's RUN step, from
+# `find users ...` through the first `jq -e` uniqueness check, run from
+# $WORK instead of the build context. Kept as one function so a change to
+# the Dockerfile's wording is one place to update, and a mismatch between
+# this and the Dockerfile is itself worth noticing.
+new_pipeline() {
+  (
+    cd "${WORK}" &&
+      find users -name '*.json' -print0 | sort -z | xargs -0 -r cat |
+        jq --slurpfile users /dev/stdin '.users += ([$users[][]] | map(profile))' \
+          parity/parity-realm.json
+  )
+}
+new_pipeline_is_unchanged_in_dockerfile() {
+  grep -qF "find users -name '*.json' -print0 | sort -z | xargs -0 -r cat" "${DOCKERFILE}" &&
+    grep -qF "jq --slurpfile users /dev/stdin '.users += ([\$users[][]] | map(profile))'" "${DOCKERFILE}"
+}
+if new_pipeline_is_unchanged_in_dockerfile; then
+  pass "the Dockerfile's RUN step still reads find | sort -z | xargs -0 | jq --slurpfile"
+else
+  fail "build/authz-agent-transfer/Dockerfile no longer matches the pipeline this test exercises; update both"
+fi
+
+# A user file missing firstName, lastName and email gets them from "profile"
+# (parity-jane-doe -> firstName Parity, lastName JaneDoe from the username,
+# email from the username); a user file that already sets firstName keeps it,
+# and still gets the other two defaulted. The two files are named so that
+# neither creation order nor a directory listing's own order would sort them
+# this way by accident: 100- sorts after 05- only because '1' follows '0'.
+printf '[{"username": "parity-admin", "firstName": "Custom"}]' >"${WORK}/users/100-admin.json"
+printf '[{"username": "parity-jane-doe"}]' >"${WORK}/users/05-jane.json"
+merged="$(new_pipeline)"
+usernames="$(jq -c '[.users[].username]' <<<"${merged}")"
+if [[ "${usernames}" == '["seed-user","parity-jane-doe","parity-admin"]' ]]; then
+  pass "users merge in filename order (05- before 100-), after the realm's own users"
+else
+  fail "expected users in filename order, got ${usernames}"
+fi
+admin_profile="$(jq -c '.users[] | select(.username == "parity-admin") | {firstName, lastName, email}' <<<"${merged}")"
+if [[ "${admin_profile}" == '{"firstName":"Custom","lastName":"Admin","email":"parity-admin@example.test"}' ]]; then
+  pass "a user file's own firstName is kept, and lastName/email are still defaulted"
+else
+  fail "parity-admin's profile is ${admin_profile}"
+fi
+jane_profile="$(jq -c '.users[] | select(.username == "parity-jane-doe") | {firstName, lastName, email}' <<<"${merged}")"
+if [[ "${jane_profile}" == '{"firstName":"Parity","lastName":"JaneDoe","email":"parity-jane-doe@example.test"}' ]]; then
+  pass "a user file with no profile fields gets all three defaulted from its username"
+else
+  fail "parity-jane-doe's profile is ${jane_profile}"
+fi
+
+# A user file name with a space used to split across two arguments of the
+# unquoted $(find ...) the Dockerfile ran before this change, which made jq
+# fail with "Could not open file users/20 users: No such file or directory"
+# on every build whose checkout happened to lay the file out that way. The
+# new pipeline passes names through -print0/-0, so a space is just a
+# character in the name.
+rm -f "${WORK}/users/100-admin.json" "${WORK}/users/05-jane.json"
+printf '[{"username": "parity-bob"}]' >"${WORK}/users/20 users with a space.json"
+merged="$(new_pipeline)"
+usernames="$(jq -c '[.users[].username]' <<<"${merged}")"
+if [[ "${usernames}" == '["seed-user","parity-bob"]' ]]; then
+  pass "a user file name with a space is read whole, not split on the space"
+else
+  fail "expected seed-user and parity-bob, got ${usernames}"
+fi
+rm -f "${WORK}/users/20 users with a space.json"
+
+# Two files that both declare parity-jane-doe must still fail the build: the
+# merge itself cannot and does not reject it (jq --slurpfile only
+# concatenates), so this is the existing uniqueness check downstream in the
+# same RUN step, and the new merge must not have broken it.
+printf '[{"username": "parity-jane-doe"}]' >"${WORK}/users/a.json"
+printf '[{"username": "parity-jane-doe"}]' >"${WORK}/users/b.json"
+if merged="$(new_pipeline)" && jq -e '[.users[].username] | length == (unique | length)' <<<"${merged}" >/dev/null; then
+  fail "two user files declaring the same username were accepted"
+else
+  pass "two user files declaring the same username still fail the uniqueness check"
+fi
+rm -f "${WORK}/users/a.json" "${WORK}/users/b.json"
+
+# No user files at all (the state of testdata/realm/ today, which holds only
+# a README): the realm keeps exactly its own users.
+merged="$(new_pipeline)"
+usernames="$(jq -c '[.users[].username]' <<<"${merged}")"
+if [[ "${usernames}" == '["seed-user"]' ]]; then
+  pass "with no user files, the realm's own users pass through unchanged"
+else
+  fail "expected only seed-user, got ${usernames}"
+fi
+
+echo
+if (( failures > 0 )); then
+  echo "chart-files merge checks: ${failures} failure(s)"
+  exit 1
+fi
+echo "chart-files merge checks: all passed"
