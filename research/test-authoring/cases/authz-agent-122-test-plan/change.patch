+	}
+	got := calls[0]
+	if got.RequestURI != "/users/a%2Fb%20c%3F?x=1" || got.Path != "/users/a/b c?" {
+		t.Errorf("requestUri %q, path %q, want %q and %q", got.RequestURI, got.Path, "/users/a%2Fb%20c%3F?x=1", "/users/a/b c?")
+	}
+}
