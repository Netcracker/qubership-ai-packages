+  @Test
+  public void aTypeVariableIsJudgedByItsDeclaredBoundAgainstAnExtendsWildcardRequirement() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              static class Box<T extends @Nullable Object> {}
+              static void takeNonNull(Box<? extends Object> b) {}
+              static void takeNullable(Box<? extends @Nullable Object> b) {}
+              static void takeAny(Box<?> b) {}
+              static <T extends @Nullable Object> void aNullableBoundFailsNonNullRequirement(Box<T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T> void aNonNullBoundMeetsNonNullRequirement(Box<T> b) {
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object> void aNullableBoundMeetsNullableRequirement(Box<T> b) {
+                takeNullable(b);
+              }
+              static <T extends @Nullable Object> void aNullableBoundMeetsUnboundedRequirement(Box<T> b) {
+                takeAny(b);
+              }
+            }
+            """)
+        .doTest();
+  }
