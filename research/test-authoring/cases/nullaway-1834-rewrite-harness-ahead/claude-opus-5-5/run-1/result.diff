+
+  @Test
+  public void aTypeVariableIsJudgedByItsDeclaredBoundWhereAWildcardRequiresANonNullBound() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.NonNull;
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.NullUnmarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              static class Box<E extends @Nullable Object> {}
+              static void takeNonNull(Box<? extends Object> b) {}
+              static void takeNullable(Box<? extends @Nullable Object> b) {}
+              static void takeAny(Box<?> b) {}
+              static <T extends @Nullable Object> void nullableBound(Box<T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+                takeNullable(b);
+                takeAny(b);
+              }
+              static <T> void nonNullBound(Box<T> b) {
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object, S extends T> void boundThatIsANullableBoundVariable(
+                  Box<S> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<S> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object> void wildcardBoundedByANullableBoundVariable(
+                  Box<? extends T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<? extends T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object> void nonNullWrittenAtTheUse(Box<@NonNull T> b) {
+                takeNonNull(b);
+              }
+              static <T> void nullableWrittenAtTheUse(Box<@Nullable T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<@Nullable T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+                takeNullable(b);
+              }
+              @NullUnmarked
+              static class Unmarked<T> {
+                @NullMarked
+                void declaredInUnannotatedCode(Box<T> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                  takeNonNull(b);
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
+
+  @Test
+  public void
+      aWildcardBoundedByATypeVariableRejectsAnActualThatAdmitsNullWhereTheVariableDoesNot() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import java.util.List;
+            import java.util.Map;
+            import java.util.Set;
+            import java.util.concurrent.CompletableFuture;
+            import org.jspecify.annotations.NonNull;
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              static class Box<E extends @Nullable Object> {}
+              static <T extends @Nullable Object> Box<? extends T> sameVariable(Box<T> b) {
+                return b;
+              }
+              static class NullableBound<T extends @Nullable Object> {
+                void takeExtendsT(Box<? extends T> b) {}
+                void takeExtendsNonNullT(Box<? extends @NonNull T> b) {}
+                <S extends T> void variableThatExtendsIt(Box<S> b) {
+                  takeExtendsT(b);
+                }
+                void unannotatedUse(Box<T> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends T>
+                  takeExtendsNonNullT(b);
+                }
+                void nullableWrittenAtTheUse(Box<@Nullable T> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<@Nullable T> cannot be converted to Box<? extends T>
+                  takeExtendsT(b);
+                }
+              }
+              static class NonNullBound<T> {
+                void takeExtendsT(Box<? extends T> b) {}
+                <S extends T> void variableThatExtendsIt(Box<S> b) {
+                  takeExtendsT(b);
+                }
+                <S extends @Nullable T> void variableThatExtendsItAndAdmitsNull(Box<S> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<S> cannot be converted to Box<? extends T>
+                  takeExtendsT(b);
+                }
+              }
+              interface Loader<K, V extends @Nullable Object> {
+                V load();
+                Map<? extends K, ? extends @NonNull V> loadAll(Set<? extends K> keys);
+                Map<? extends K, ? extends V> loadEverything();
+                default CompletableFuture<? extends V> inferredFromTheVariable() {
+                  return CompletableFuture.supplyAsync(() -> load());
+                }
+                default CompletableFuture<? extends Map<? extends K, ? extends @NonNull V>>
+                    capturedFromANonNullBound(Set<? extends K> keys) {
+                  return CompletableFuture.supplyAsync(() -> loadAll(keys));
+                }
+                default Map<? extends K, ? extends V> capturedFromAnUnannotatedBound() {
+                  return loadEverything();
+                }
+              }
+              interface NonNullProjection<V extends @Nullable Object> {
+                List<? extends @NonNull V> get();
+                static <V extends @Nullable Object> NonNullProjection<V> overriddenWithTheVariable() {
+                  return new NonNullProjection<>() {
+                    // BUG: Diagnostic contains: mismatched type parameter nullability
+                    @Override public List<V> get() {
+                      throw new UnsupportedOperationException();
+                    }
+                  };
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
