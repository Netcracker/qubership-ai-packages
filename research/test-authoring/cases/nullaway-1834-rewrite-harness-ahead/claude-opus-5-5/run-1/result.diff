+  @Test
+  public void aTypeVariableArgumentFailsANonNullWildcardRequirementOnlyWhenItAdmitsNull() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.NonNull;
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.NullUnmarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              static class Box<E extends @Nullable Object> {}
+              static void takeNonNull(Box<? extends Object> b) {}
+              static void takeNullable(Box<? extends @Nullable Object> b) {}
+              static void takeAny(Box<?> b) {}
+              static <T extends @Nullable Object> void nullableBound(Box<T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T> void nonNullBound(Box<T> b) {
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object> void nullableBoundIntoNullableWildcard(Box<T> b) {
+                takeNullable(b);
+              }
+              static <T extends @Nullable Object> void nullableBoundIntoUnboundedWildcard(Box<T> b) {
+                takeAny(b);
+              }
+              static <T extends @Nullable Object> void nonNullUseOfNullableBound(Box<@NonNull T> b) {
+                takeNonNull(b);
+              }
+              static <T> void nullableUseOfNonNullBound(Box<@Nullable T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<@Nullable T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T> void nullableUseIntoNullableWildcard(Box<@Nullable T> b) {
+                takeNullable(b);
+              }
+              static <T extends @Nullable Object, S extends T> void boundedByNullableBound(Box<S> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<S> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object> void wildcardBoundedByNullableBound(Box<? extends T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<? extends T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              @NullUnmarked
+              static class UnannotatedHolder<U> {
+                @NullMarked
+                void declaredInUnannotatedCode(Box<U> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<U> cannot be converted to Box<? extends Object>
+                  takeNonNull(b);
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
