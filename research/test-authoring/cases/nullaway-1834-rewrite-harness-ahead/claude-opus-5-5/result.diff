+  @Test
+  public void aTypeVariableIsJudgedByItsDeclaredBoundAgainstAConcreteWildcardBound() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import org.jspecify.annotations.NonNull;
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.NullUnmarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              static class Box<E extends @Nullable Object> {}
+              static void takeNonNull(Box<? extends Object> b) {}
+              static void takeNullable(Box<? extends @Nullable Object> b) {}
+              static void takeAny(Box<?> b) {}
+              static <T extends @Nullable Object> void boundAdmitsNull(Box<T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+                takeNullable(b);
+                takeAny(b);
+              }
+              static <T> void boundExcludesNull(Box<T> b) {
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object, S extends T> void boundIsAVariableWhoseBoundAdmitsNull(
+                  Box<S> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<S> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              static <T extends @Nullable Object> void reachedThroughAWildcard(Box<? extends T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<? extends T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+              }
+              @NullUnmarked
+              static class Unannotated<T> {
+                @NullMarked
+                void declaredInUnannotatedCode(Box<T> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<T> cannot be converted to Box<? extends Object>
+                  takeNonNull(b);
+                }
+              }
+              // a nullness annotation at the use overrides the declared bound
+              static <T> void nullableAtTheUse(Box<@Nullable T> b) {
+                // BUG: Diagnostic contains: incompatible types: Box<@Nullable T> cannot be converted to Box<? extends Object>
+                takeNonNull(b);
+                takeNullable(b);
+              }
+              static <T extends @Nullable Object> void nonNullAtTheUse(Box<@NonNull T> b) {
+                takeNonNull(b);
+              }
+            }
+            """)
+        .doTest();
+  }
