+                    @Override public List<V> get() {
+                      throw new UnsupportedOperationException();
+                    }
+                  };
+                }
+                static <V extends @Nullable Object> Source<V> overrideWithNonNullVariable() {
+                  return new Source<>() {
+                    @Override public List<@NonNull V> get() {
+                      throw new UnsupportedOperationException();
+                    }
+                  };
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
