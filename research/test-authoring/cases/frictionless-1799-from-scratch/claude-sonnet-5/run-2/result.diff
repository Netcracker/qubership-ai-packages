+def test_analyze_resource_with_extra_label_dropped_by_header_mismatch_issue_1791():
+    # "name" is an extra column beyond the schema's single field, so
+    # `fieldsMatch: "exact"` (the default) gives it a synthetic field that
+    # is not one of `resource.schema.fields`. Computing stats from the
+    # schema's own fields, restricted to the ones actually expected, keeps
+    # the analyzer from trying to look that synthetic field up in the
+    # schema.
+    schema = Schema.from_descriptor({"fields": [{"name": "id", "type": "integer"}]})
+    resource = TableResource(
+        data=[["id", "name"], [1, "english"], [2, "german"]], schema=schema
+    )
+    analysis = resource.analyze(detailed=True)
+    assert analysis["fields"] == 1
+    assert analysis["rows"] == 2
+    assert list(analysis["fieldStats"].keys()) == ["id"]
+    assert analysis["variableTypes"] == {"integer": 1}
+
+
