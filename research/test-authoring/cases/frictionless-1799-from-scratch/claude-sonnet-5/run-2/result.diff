+def test_resource_schema_foreign_keys_with_a_field_dropped_by_a_header_mismatch_issue_1791():
+    # "cat" is beyond the header's length, so `fieldsMatch: "exact"` (the
+    # default) drops it from the expected fields. The foreign key that
+    # targets it is then skipped too, rather than reading a cell the row
+    # does not have.
+    descriptor = {
+        "name": "name",
+        "data": [["id", "name"], [1, "England"], [2, "France"]],
+        "schema": {
+            "fields": [
+                {"name": "id", "type": "integer"},
+                {"name": "name", "type": "string"},
+                {"name": "cat", "type": "integer"},
+            ],
+            "foreignKeys": [
+                {"fields": "cat", "reference": {"resource": "", "fields": "id"}}
+            ],
+        },
+    }
+    resource = TableResource.from_descriptor(descriptor)
+    rows = resource.read_rows()
+    assert rows[0].valid
+    assert rows[1].valid
+    assert rows[0].to_dict() == {"id": 1, "name": "England"}
+    assert rows[1].to_dict() == {"id": 2, "name": "France"}
+    assert [error.type for error in resource.header.errors] == ["missing-label"]
+
+
