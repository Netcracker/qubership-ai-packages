+def test_resource_schema_unique_with_a_field_dropped_by_a_header_mismatch_issue_1791():
+    # "name" is beyond the header's length, so `fieldsMatch: "exact"` (the
+    # default) drops it from the expected fields instead of checking its
+    # (always missing) cell for uniqueness on every row.
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "integer"},
+                {"name": "name", "type": "string", "constraints": {"unique": True}},
+            ]
+        }
+    )
+    with TableResource(data=[["id"], [1], [2]], schema=schema) as resource:
+        for row in resource.row_stream:
+            assert row.valid
+        assert resource.header.valid is False
+        assert [error.type for error in resource.header.errors] == ["missing-label"]
+
