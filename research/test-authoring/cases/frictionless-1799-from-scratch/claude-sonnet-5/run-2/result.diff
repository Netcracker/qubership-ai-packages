+def test_resource_validate_fields_match_superset_tolerates_foreign_key_on_absent_field():
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "name", "type": "string"},
+                {"name": "parent", "type": "string"},
+            ],
+            "foreignKeys": [
+                {
+                    "fields": ["parent"],
+                    "reference": {"resource": "", "fields": ["name"]},
+                }
+            ],
+            "fieldsMatch": "superset",
+        }
+    )
+    resource = TableResource(data=[["name"], ["a"], ["b"]], schema=schema)
+    report = resource.validate()
+    assert report.valid
