+def test_resource_validate_schema_primary_key_field_missing_from_header_issue_1791():
+    # The primary key field is declared but has no label in the header, so
+    # its cells are "None" on every row; before the fix, that was also
+    # reported as a primary-key error on every row, on top of the header's
+    # own missing-label error.
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "name", "type": "string"},
+            ],
+            "primaryKey": ["name"],
+        }
+    )
+    resource = TableResource(data=[["id"], ["1"], ["2"]], schema=schema)
+    report = resource.validate()
+    assert report.flatten(["rowNumber", "fieldNumber", "type"]) == [
+        [None, 2, "missing-label"],
+    ]
