+def test_analyze_resource_schema_field_missing_from_header_issue_1791():
+    # "age" has no label in data/table.csv at all; before the fix, a field
+    # beyond the header's length was still analyzed as an all-null column.
+    schema = Schema(
+        fields=[
+            fields.StringField(name="id"),
+            fields.StringField(name="name"),
+            fields.IntegerField(name="age"),
+        ]
+    )
+    resource = TableResource(path="data/table.csv", schema=schema)
+    analysis = resource.analyze(detailed=True)
+    assert analysis["variableTypes"] == {"string": 2}
+    assert list(analysis["fieldStats"].keys()) == ["id", "name"]
