diff --git a/frictionless/resources/__spec__/table/test_schema.py b/frictionless/resources/__spec__/table/test_schema.py
index a7883d1..0a42e55 100644
--- a/frictionless/resources/__spec__/table/test_schema.py
+++ b/frictionless/resources/__spec__/table/test_schema.py
@@ -5,6 +5,7 @@ import pytest
 
 from frictionless import (
     Detector,
+    Dialect,
     FrictionlessException,
     Package,
     Resource,
@@ -399,3 +400,79 @@ def test_resource_schema_circular_foreign_keys(test_case):
         test_case["expected_validity_b"],
         test_case["expected_errors_b"],
     )
+
+
+# Fields match: integrity checks follow the fields the row stream actually
+# reads, not the full schema
+#
+# A `fieldsMatch` mode that tolerates a field missing from the header (e.g.
+# "superset") drops that field from the row stream entirely (Header,
+# `get_expected_fields`); the unique, primary key, and foreign key checks
+# below must follow that same dropped set, or they reach for a field the row
+# doesn't carry.
+
+
+def test_resource_schema_unique_ignores_a_field_absent_from_the_header():
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "a", "type": "integer"},
+                {"name": "b", "type": "integer", "constraints": {"unique": True}},
+            ],
+            "fieldsMatch": "superset",
+        }
+    )
+    with TableResource(data=[["a"], [1], [2]], schema=schema) as resource:
+        for row in resource.row_stream:
+            assert row.valid
+
+
+def test_resource_schema_primary_key_ignores_a_field_absent_from_the_header():
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "a", "type": "integer"},
+                {"name": "b", "type": "integer"},
+            ],
+            "primaryKey": ["b"],
+            "fieldsMatch": "superset",
+        }
+    )
+    # header_case=False looks up "b" among the row's own field names instead
+    # of raising KeyError for it, so every row used to compare equal on an
+    # empty primary key and all but the first were reported as duplicates.
+    resource = TableResource(
+        data=[["a"], [1], [2]], schema=schema, dialect=Dialect(header_case=False)
+    )
+    with resource:
+        for row in resource.row_stream:
+            assert row.valid
+
+
+def test_resource_schema_foreign_keys_ignore_a_field_absent_from_the_header():
+    descriptor = {
+        "resources": [
+            {
+                "name": "main",
+                "data": [["a"], [1], [2]],
+                "schema": {
+                    "fields": [
+                        {"name": "a", "type": "integer"},
+                        {"name": "b", "type": "integer"},
+                    ],
+                    "fieldsMatch": "superset",
+                    "foreignKeys": [
+                        {
+                            "fields": "b",
+                            "reference": {"resource": "other", "fields": "id"},
+                        }
+                    ],
+                },
+            },
+            {"name": "other", "data": [["id"], [1], [2]]},
+        ]
+    }
+    resource = Package.from_descriptor(descriptor).get_table_resource("main")
+    with resource:
+        for row in resource.row_stream:
+            assert row.valid
