+
+
+# Fields match: analysis follows the fields the row stream actually reads
+#
+# A label the schema does not declare gets a dynamic field with no entry in
+# `resource.schema.fields` (Header.get_expected_fields); a `fieldsMatch` mode
+# that tolerates a field missing from the header drops it from the row stream
+# the same way. Analysis must read the row stream's own fields instead of the
+# full schema, or it reaches for a field that isn't there.
+
+
+def test_analyze_resource_with_a_label_not_declared_in_the_schema():
+    schema = Schema.from_descriptor(
+        {"fields": [{"name": "a", "type": "integer"}], "fieldsMatch": "equal"}
+    )
+    resource = TableResource(data=[["a", "extra"], [1, "x"], [2, "y"]], schema=schema)
+    analysis = resource.analyze()
+    assert analysis["rows"] == 2
+    assert analysis["notNullRows"] == 2
+    assert analysis["rowsWithNullValues"] == 0
+
+
+def test_analyze_resource_detailed_with_a_field_missing_from_the_header():
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "a", "type": "integer"},
+                {"name": "b", "type": "integer"},
+            ],
+            "fieldsMatch": "superset",
+        }
+    )
+    resource = TableResource(data=[["a"], [1], [2], [3]], schema=schema)
+    analysis = resource.analyze(detailed=True)
+    assert list(analysis["fieldStats"].keys()) == ["a"]
+    assert analysis["fieldStats"]["a"]["mean"] == 2
