+def test_get_expected_fields_exact_synthetic_field_avoids_name_collision():
+    # The second "a" is beyond the one declared field and gets a synthetic
+    # any-typed field of its own; it cannot be named "a" too, since that
+    # would collide with the first field.
+    header = _make_header(["a", "a"], ["a"], fields_match="exact")
+    assert [f.name for f in header.get_expected_fields()] == ["a", "a2"]
