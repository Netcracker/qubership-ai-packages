+def test_analyze_resource_detailed_skips_a_field_missing_from_the_header_issue_1791():
+    # "data/table.csv" only has "id" and "name" columns; the declared "bad"
+    # field has no label at all under the default "exact" fieldsMatch, so it
+    # never reaches `columns_data` during the row pass. Walking the full
+    # schema afterwards, instead of only the fields the header actually
+    # carries, would look "bad" up in `columns_data` and raise a `KeyError`.
+    schema = Schema.describe("data/table.csv")
+    schema.add_field(fields.IntegerField(name="bad"))
+    resource = TableResource(path="data/table.csv", schema=schema)
+    analysis = resource.analyze(detailed=True)
+    assert list(analysis["fieldStats"].keys()) == ["id", "name"]
