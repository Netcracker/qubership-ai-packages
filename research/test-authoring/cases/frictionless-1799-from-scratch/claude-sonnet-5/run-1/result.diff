+def test_resource_exact_header_mismatch_reports_an_extra_label_only_once_issue_1791():
+    # The extra label is already reported once as a header error; a row that
+    # matches the header's length no longer owes a duplicate extra-cell error
+    # for it. A row that is also irregular on top of that still reports one.
+    schema = Schema(fields=[fields.AnyField(name="id")])
+    with TableResource(
+        data=[["id", "name"], [1, "london"], [2, "paris", "irregular"]], schema=schema
+    ) as resource:
+        rows = resource.read_rows()
+    assert [e.type for e in resource.header.errors] == ["extra-label"]
+    assert rows[0] == {"id": 1, "name": "london"}
+    assert rows[0].errors == []
+    assert [e.type for e in rows[1].errors] == ["extra-cell"]
+
+
+def test_resource_exact_header_mismatch_reports_a_missing_label_only_once_issue_1791():
+    # The missing label is already reported once as a header error; a row
+    # that matches the header's length no longer owes a duplicate
+    # missing-cell error for it. A row that is also irregular on top of that
+    # still reports one.
+    schema = Schema(
+        fields=[
+            fields.AnyField(name="id"),
+            fields.AnyField(name="code"),
+            fields.AnyField(name="name"),
+        ]
+    )
+    with TableResource(data=[["id", "code"], [1, "x"], [2]], schema=schema) as resource:
+        rows = resource.read_rows()
+    assert [e.type for e in resource.header.errors] == ["missing-label"]
+    assert rows[0] == {"id": 1, "code": "x"}
+    assert rows[0].errors == []
+    assert [e.type for e in rows[1].errors] == ["missing-cell"]
+
+
+def test_resource_name_matched_fields_match_without_a_header_reads_rows_by_schema_order():
+    # Without a header there is nothing to match labels against; every row of
+    # a non-"exact" fieldsMatch mode used to come back empty in this case.
+    schema = Schema(
+        fields=[fields.AnyField(name="a"), fields.AnyField(name="b")],
+        fields_match="equal",
+    )
+    dialect = Dialect(header=False)
+    with TableResource(data=[[1, 2], [3, 4]], schema=schema, dialect=dialect) as resource:
+        rows = resource.read_rows()
+    assert [dict(row) for row in rows] == [{"a": 1, "b": 2}, {"a": 3, "b": 4}]
+    assert all(row.errors == [] for row in rows)
+
+
+def test_resource_unique_constraint_does_not_crash_on_a_field_missing_from_a_superset_header():
+    # "extra" is absent from the header, which "superset" tolerates; checking
+    # its uniqueness must not crash on a field no row ever read.
+    schema = Schema(
+        fields=[
+            fields.AnyField(name="id"),
+            fields.AnyField(name="extra", constraints={"unique": True}),
+        ],
+        fields_match="superset",
+    )
+    with TableResource(data=[["id"], [1], [2]], schema=schema) as resource:
+        rows = resource.read_rows()
+    assert resource.header.valid
+    assert all(row.errors == [] for row in rows)
