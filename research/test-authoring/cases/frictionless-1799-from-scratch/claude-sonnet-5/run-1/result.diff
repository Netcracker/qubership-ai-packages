+def test_get_expected_fields_exact_extra_label_colliding_with_a_field_gets_a_suffix():
+    # The second "a" label has no field of its own (there is only one "a"
+    # field, and it is claimed by the first label), so it falls back to a
+    # synthetic field named after the label; "a" is already taken.
+    header = _make_header(["a", "a"], ["a"], fields_match="exact")
+    actual = [f.name for f in header.get_expected_fields()]
+    assert actual == ["a", "a2"]
+
