+def test_analyze_resource_excludes_a_field_missing_from_the_header():
+    # Under the default `fieldsMatch: "exact"`, "age" is beyond the two
+    # labels the header carries, so it has no data column behind it; the
+    # analysis must not invent stats for it.
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "name", "type": "string"},
+                {"name": "age", "type": "integer"},
+            ]
+        }
+    )
+    resource = TableResource(
+        data=[["id", "name"], ["1", "english"], ["2", "french"]], schema=schema
+    )
+    analysis = resource.analyze(detailed=True)
+    assert list(analysis["fieldStats"].keys()) == ["id", "name"]
+    assert analysis["variableTypes"] == {"string": 2}
