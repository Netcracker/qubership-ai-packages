+def test_resource_schema_primary_key_label_missing_is_not_rechecked_per_row():
+    # Under the default `fieldsMatch: "exact"`, the "id" field is beyond the
+    # single label the header carries, so `header.get_expected_fields()` drops
+    # it; the header already reports that once as `missing-label`, and no row
+    # should get a redundant `primary-key` error for a field it never had.
+    schema = Schema.from_descriptor(
+        {"fields": [{"name": "name"}, {"name": "id"}], "primaryKey": ["id"]}
+    )
+    with TableResource(data=[["name"], ["a"], ["b"], ["c"]], schema=schema) as resource:
+        assert resource.header.valid is False
+        for row in resource.row_stream:
+            assert row.valid
+
