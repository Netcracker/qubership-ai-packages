+def test_resource_schema_foreign_key_target_label_missing_does_not_raise():
+    # "cat", the foreign key's target field, is beyond the single label the
+    # header carries and is dropped from `header.get_expected_fields()`; the
+    # foreign key check must skip it instead of looking up a row cell that
+    # does not exist.
+    schema = Schema.from_descriptor(
+        {
+            "fields": [{"name": "name"}, {"name": "cat"}],
+            "foreignKeys": [
+                {"fields": "cat", "reference": {"resource": "", "fields": "name"}}
+            ],
+        }
+    )
+    with TableResource(data=[["name"], ["a"], ["b"]], schema=schema) as resource:
+        assert resource.header.valid is False
+        for row in resource.row_stream:
+            assert row.valid
