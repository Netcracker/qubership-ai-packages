+def test_resource_validate_fields_match_exact_still_reports_an_irregular_row():
+    # The missing "extra" field is no longer rechecked on every row (that is
+    # the single header-level `missing-label` below), but a row that is
+    # itself irregular, with more cells than the header has columns, still
+    # gets its own cell error.
+    schema = Schema.from_descriptor(
+        {"fields": [{"name": "id"}, {"name": "name"}, {"name": "extra"}]}
+    )
+    resource = TableResource(
+        data=[["id", "name"], ["1", "english"], ["2", "french", "unexpected"]],
+        schema=schema,
+    )
+    report = frictionless.validate(resource)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 3, "extra", "missing-label"],
+        [3, 3, "", "extra-cell"],
+    ]
+
