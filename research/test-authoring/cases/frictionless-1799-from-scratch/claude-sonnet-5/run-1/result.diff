+def test_get_expected_fields_exact_extra_labels_colliding_with_each_other_get_suffixes():
+    header = _make_header(["x", "x"], [], fields_match="exact")
+    actual = [f.name for f in header.get_expected_fields()]
+    assert actual == ["x", "x2"]
