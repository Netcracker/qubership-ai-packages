+        pytest.param(["a"], "partial", ["a"], id="partial, extra label"),
+    ],
+)
+def test_analyze_resource_detailed_with_header_mismatch(
+    field_names, fields_match, expected_field_stats
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [{"name": name, "type": "integer"} for name in field_names],
+            "fieldsMatch": fields_match,
+        }
+    )
+    resource = TableResource(data=[["a", "b"], [1, 2], [3, 4]], schema=schema)
+    analysis = resource.analyze(detailed=True)
+    assert {
+        "fieldStats": list(analysis["fieldStats"].keys()),
+        "notNullRows": analysis["notNullRows"],
+        "rowsWithNullValues": analysis["rowsWithNullValues"],
+    } == {
+        "fieldStats": expected_field_stats,
+        "notNullRows": 2,
+        "rowsWithNullValues": 0,
+    }
