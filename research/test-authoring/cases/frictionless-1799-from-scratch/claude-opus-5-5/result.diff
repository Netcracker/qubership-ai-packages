+        ("subset", [[None, 3, "other", "missing-label"], [3, None, None, "foreign-key"]]),
+        ("superset", [[3, None, None, "foreign-key"]]),
+        ("partial", [[3, None, None, "foreign-key"]]),
+    ],
+)
+def test_resource_validate_fields_match_foreign_key_is_checked_on_present_fields_only(
+    fields_match, expected
+):
+    # Both "parent" and "other" refer to "id"; the data has a dangling "parent"
+    # and lacks "other".
+    schema = Schema.from_descriptor(
+        {
+            "fields": [{"name": "id"}, {"name": "parent"}, {"name": "other"}],
+            "foreignKeys": [
+                {"fields": ["parent"], "reference": {"resource": "", "fields": ["id"]}},
+                {"fields": ["other"], "reference": {"resource": "", "fields": ["id"]}},
+            ],
+            "fieldsMatch": fields_match,
+        }
+    )
+    resource = TableResource([["id", "parent"], ["1", ""], ["2", "9"]], schema=schema)
+    report = frictionless.validate(resource)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
