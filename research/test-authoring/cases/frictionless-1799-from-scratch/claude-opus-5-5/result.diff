+def test_resource_validate_fields_match_unique_is_checked_only_on_fields_in_the_header(
+    fields_match, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string", "constraints": {"unique": True}},
+                {"name": "key", "type": "string", "constraints": {"unique": True}},
+            ],
+            "fieldsMatch": fields_match,
+        }
+    )
+    resource = TableResource([["id"], ["1"], ["1"]], schema=schema)
+    report = frictionless.validate(resource)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+# Header mismatches under `exact`
+#
+# A mismatch between the header and the schema is reported once, by the
+# header; the rows are checked against the header, so only a row whose
+# length differs from the header's reports a cell error.
+
+IRREGULAR_ROWS = [["id", "name"], ["1", "a"], ["2"], ["3", "b", "x"]]
+
+
+@pytest.mark.parametrize(
+    "field_names, expected",
+    [
+        pytest.param(
+            ["id", "name", "extra"],
+            [
+                [None, 3, "extra", "missing-label"],
+                [3, 2, "name", "missing-cell"],
+                [4, 3, "", "extra-cell"],
+            ],
+            id="missing label",
+        ),
+        pytest.param(
+            ["id"],
+            [
+                [None, 2, "", "extra-label"],
+                [3, 2, "name", "missing-cell"],
+                [4, 3, "", "extra-cell"],
+            ],
+            id="extra label",
+        ),
+    ],
+)
+def test_resource_validate_header_mismatch_reports_cell_errors_only_for_irregular_rows(
+    field_names, expected
+):
+    report = _validate_fields_match(field_names, "exact", IRREGULAR_ROWS)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+def test_resource_extra_label_repeating_a_field_name_is_read_as_its_own_cell():
+    schema = Schema.from_descriptor({"fields": [{"name": "a", "type": "integer"}]})
+    with TableResource([["a", "a"], ["1", "x"]], schema=schema) as resource:
+        assert resource.read_rows() == [{"a": 1, "a2": "x"}]
+
+
+@pytest.mark.parametrize(
+    "source, primary_key, header_case, expected",
+    [
+        pytest.param(
+            [["id", "key"], ["1", "k"], ["2", "k"]],
+            ["key"],
+            True,
+            [[3, None, None, "primary-key"]],
+            id="key in the header",
+        ),
+        pytest.param(
+            [["id"], ["1"], ["2"]],
+            ["key"],
+            True,
+            [[None, 2, "key", "missing-label"]],
+            id="key not in the header",
+        ),
+        pytest.param(
+            [["id"], ["1"], ["1"]],
+            ["id", "key"],
+            True,
+            [[None, 2, "key", "missing-label"]],
+            id="part of a composite key not in the header",
+        ),
+        pytest.param(
+            [["id"], ["1"], ["2"]],
+            ["key"],
+            False,
+            [[None, 2, "key", "missing-label"]],
+            id="key not in the header, ignoring case",
+        ),
+        pytest.param(
+            [["id"], ["1"], ["1"]],
+            ["id", "key"],
+            False,
+            [[None, 2, "key", "missing-label"]],
+            id="part of a composite key not in the header, ignoring case",
+        ),
+    ],
+)
+def test_resource_validate_primary_key_is_checked_only_when_its_fields_are_in_the_header(
+    source, primary_key, header_case, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "key", "type": "string"},
+            ],
+            "primaryKey": primary_key,
+        }
+    )
+    resource = TableResource(
+        source, schema=schema, dialect=Dialect(header_case=header_case)
+    )
+    report = frictionless.validate(resource)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+@pytest.mark.parametrize(
+    "fields_match, source, expected",
+    [
+        pytest.param(
+            "exact",
+            [["id", "parent"], ["1", "1"], ["2", "9"]],
+            [[3, None, None, "foreign-key"]],
+            id="exact, key in the header",
+        ),
+        pytest.param(
+            "exact",
+            [["id"], ["1"], ["2"]],
+            [[None, 2, "parent", "missing-label"]],
+            id="exact, key not in the header",
+        ),
+        pytest.param(
+            "partial",
+            [["id", "parent"], ["1", "1"], ["2", "9"]],
+            [[3, None, None, "foreign-key"]],
+            id="partial, key in the header",
+        ),
+        pytest.param(
+            "partial",
+            [["id"], ["1"], ["2"]],
+            [],
+            id="partial, key not in the header",
+        ),
+    ],
+)
+def test_resource_validate_foreign_key_is_checked_only_when_its_fields_are_in_the_header(
+    fields_match, source, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "parent", "type": "string"},
+            ],
+            "foreignKeys": [
+                {"fields": "parent", "reference": {"resource": "", "fields": "id"}}
+            ],
+            "fieldsMatch": fields_match,
+        }
+    )
+    report = frictionless.validate(TableResource(source, schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
