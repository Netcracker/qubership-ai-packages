+
+
+# Under `exact`, a header mismatch is reported once as a label error, while a
+# row whose length differs from the header's is still reported cell by cell.
+IRREGULAR_ROWS = [["id", "name"], ["1", "a"], ["2"], ["3", "b", "c"]]
+
+
+@pytest.mark.parametrize(
+    "field_names, expected",
+    [
+        pytest.param(
+            ["id"],
+            [
+                [None, 2, "", "extra-label"],
+                [3, 2, "name", "missing-cell"],
+                [4, 3, "", "extra-cell"],
+            ],
+            id="extra label",
+        ),
+        pytest.param(
+            ["id", "name", "extra"],
+            [
+                [None, 3, "extra", "missing-label"],
+                [3, 2, "name", "missing-cell"],
+                [4, 3, "", "extra-cell"],
+            ],
+            id="missing label",
+        ),
+    ],
+)
+def test_resource_validate_fields_match_exact_checks_row_length_against_the_header(
+    field_names, expected
+):
+    report = _validate_fields_match(field_names, "exact", IRREGULAR_ROWS)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+# Integrity checks only apply to fields present in the data: an absent field is
+# already reported as a `missing-label`, or tolerated by `fieldsMatch`.
+
+
+@pytest.mark.parametrize(
+    "primary_key, source, expected",
+    [
+        pytest.param(
+            ["key"],
+            [["id"], ["1"], ["1"]],
+            [[None, 2, "key", "missing-label"]],
+            id="key absent from the data",
+        ),
+        pytest.param(
+            ["id", "key"],
+            [["id"], ["1"], ["1"]],
+            [[None, 2, "key", "missing-label"]],
+            id="part of a composite key absent from the data",
+        ),
+        pytest.param(
+            ["key"],
+            [["id", "key"], ["1", "k"], ["2", "k"]],
+            [[3, None, None, "primary-key"]],
+            id="key present in the data",
+        ),
+    ],
+)
+def test_resource_validate_primary_key_is_checked_only_when_present(
+    primary_key, source, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "key", "type": "string"},
+            ],
+            "primaryKey": primary_key,
+        }
+    )
+    report = frictionless.validate(TableResource(source, schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+@pytest.mark.parametrize(
+    "source, expected",
+    [
+        pytest.param([["id"], ["1"], ["2"]], [], id="field absent from the data"),
+        pytest.param(
+            [["code"], ["1"], ["1"]],
+            [[3, 1, "code", "unique-error"]],
+            id="field present in the data",
+        ),
+    ],
+)
+def test_resource_validate_unique_constraint_is_checked_only_when_present(
+    source, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "code", "type": "string", "constraints": {"unique": True}},
+            ],
+            "fieldsMatch": "superset",
+        }
+    )
+    report = frictionless.validate(TableResource(source, schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+@pytest.mark.parametrize(
+    "source, expected",
+    [
+        pytest.param([["id"], ["1"], ["2"]], [], id="field absent from the data"),
+        pytest.param(
+            [["id", "parent"], ["1", "2"], ["2", "3"]],
+            [[3, None, None, "foreign-key"]],
+            id="field present in the data",
+        ),
+    ],
+)
+def test_resource_validate_foreign_key_is_checked_only_when_present(source, expected):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "parent", "type": "string"},
+            ],
+            "foreignKeys": [
+                {"fields": "parent", "reference": {"resource": "", "fields": "id"}}
+            ],
+            "fieldsMatch": "superset",
+        }
+    )
+    report = frictionless.validate(TableResource(source, schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
