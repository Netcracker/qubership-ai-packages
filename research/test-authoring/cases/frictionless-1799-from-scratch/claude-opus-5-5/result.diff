+# A header mismatch is reported once, in the header; a row still reports the
+# cells it has too many or too few of compared with the header.
+
+
+def test_resource_validate_exact_extra_label_reports_cells_only_of_irregular_rows():
+    report = _validate_fields_match(
+        ["id"], "exact", [["id", "name"], ["1", "a"], ["2", "b", "x"], ["3"]]
+    )
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 2, "", "extra-label"],
+        [3, 3, "", "extra-cell"],
+        [4, 2, "name", "missing-cell"],
+    ]
+
+
+def test_resource_validate_exact_missing_field_reports_cells_only_of_irregular_rows():
+    report = _validate_fields_match(
+        ["id", "name", "extra"],
+        "exact",
+        [["id", "name"], ["1", "a"], ["2", "b", "x"], ["3"]],
+    )
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 3, "extra", "missing-label"],
+        [3, 3, "", "extra-cell"],
+        [4, 2, "name", "missing-cell"],
+    ]
+
+
+def test_resource_exact_extra_label_named_like_a_field_keeps_the_field_cell():
