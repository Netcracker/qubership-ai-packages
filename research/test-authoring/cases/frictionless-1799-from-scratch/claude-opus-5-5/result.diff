+# Integrity checks on a field the header does not carry are skipped: its
+# absence is the header's `missing-label`, if the mode reports it at all.
+
+
+@pytest.mark.parametrize(
+    "fields_match, expected",
+    [
+        ("exact", [[None, 2, "key", "missing-label"], [3, 1, "id", "unique-error"]]),
+        ("equal", [[None, 2, "key", "missing-label"], [3, 1, "id", "unique-error"]]),
+        ("superset", [[3, 1, "id", "unique-error"]]),
+    ],
+)
+def test_resource_validate_unique_is_checked_only_on_fields_in_the_header(
+    fields_match, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string", "constraints": {"unique": True}},
+                {"name": "key", "type": "string", "constraints": {"unique": True}},
+            ],
+            "fieldsMatch": fields_match,
+        }
+    )
+    report = frictionless.validate(TableResource([["id"], ["1"], ["1"]], schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+@pytest.mark.parametrize(
+    "primary_key, expected",
+    [
+        pytest.param(
+            ["key"],
+            [[None, 2, "key", "missing-label"]],
+            id="on a field missing from the header",
+        ),
+        pytest.param(
+            ["id"],
+            [[None, 2, "key", "missing-label"], [3, None, None, "primary-key"]],
+            id="on a field in the header",
+        ),
+    ],
+)
+def test_resource_validate_exact_primary_key_is_checked_only_on_fields_in_the_header(
+    primary_key, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "string"},
+                {"name": "key", "type": "string"},
+            ],
+            "primaryKey": primary_key,
+        }
+    )
+    report = frictionless.validate(TableResource([["id"], ["1"], ["1"]], schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+# One key per case: on the base commit, a failing key on `parent` hid the
+# crash of a key on `ref`.
+@pytest.mark.parametrize(
+    "fields_match, key, expected",
+    [
+        pytest.param(
+            "exact",
+            "ref",
+            [[None, 3, "ref", "missing-label"]],
+            id="exact, on a field missing from the header",
+        ),
+        pytest.param(
+            "exact",
+            "parent",
+            [[None, 3, "ref", "missing-label"], [2, None, None, "foreign-key"]],
+            id="exact, on a field in the header",
+        ),
+        pytest.param(
+            "equal",
+            "ref",
+            [[None, 3, "ref", "missing-label"]],
+            id="equal, on a field missing from the header",
+        ),
+        pytest.param(
+            "equal",
+            "parent",
+            [[None, 3, "ref", "missing-label"], [2, None, None, "foreign-key"]],
+            id="equal, on a field in the header",
+        ),
+        pytest.param(
+            "superset",
+            "ref",
+            [],
+            id="superset, on a field missing from the header",
+        ),
+        pytest.param(
+            "superset",
+            "parent",
+            [[2, None, None, "foreign-key"]],
+            id="superset, on a field in the header",
+        ),
+    ],
+)
+def test_resource_validate_foreign_key_is_checked_only_on_fields_in_the_header(
+    fields_match, key, expected
+):
+    # Every `id` is "1", so a key on `parent` ("5") or on `ref` would fail.
+    resource = TableResource.from_descriptor(
+        {
+            "name": "name",
+            "data": [["id", "parent"], ["1", "5"]],
+            "schema": {
+                "fields": [
+                    {"name": "id", "type": "string"},
+                    {"name": "parent", "type": "string"},
+                    {"name": "ref", "type": "string"},
+                ],
+                "foreignKeys": [
+                    {"fields": key, "reference": {"resource": "", "fields": "id"}},
+                ],
+                "fieldsMatch": fields_match,
+            },
+        }
+    )
+    report = resource.validate()
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
