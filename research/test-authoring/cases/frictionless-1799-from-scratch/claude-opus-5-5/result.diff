+def test_analyze_resource_detailed_leaves_out_a_declared_field_absent_from_the_data():
+    # "b" is declared but absent; the null in "a" is a real one.
+    schema = Schema.from_descriptor(
+        {"fields": [{"name": "a", "type": "integer"}, {"name": "b", "type": "integer"}]}
+    )
+    resource = TableResource([["a"], [1], [None]], schema=schema)
+    analysis = resource.analyze(detailed=True)
+    assert {
+        "fieldStats": list(analysis["fieldStats"]),
+        "variableTypes": analysis["variableTypes"],
+        "rowsWithNullValues": analysis["rowsWithNullValues"],
+        "notNullRows": analysis["notNullRows"],
+    } == {
+        "fieldStats": ["a"],
+        "variableTypes": {"integer": 1},
+        "rowsWithNullValues": 1,
+        "notNullRows": 1,
+    }
+
+
+def test_analyze_resource_detailed_leaves_out_an_undeclared_column():
+    schema = Schema.from_descriptor({"fields": [{"name": "a", "type": "integer"}]})
+    resource = TableResource([["a", "b"], [1, 2], [2, 3]], schema=schema)
+    analysis = resource.analyze(detailed=True)
+    assert {
+        "fieldStats": list(analysis["fieldStats"]),
+        "variableTypes": analysis["variableTypes"],
+    } == {"fieldStats": ["a"], "variableTypes": {"integer": 1}}
