+def _summary(analysis):
+    return {
+        "fieldStats": list(analysis["fieldStats"]),
+        "rowsWithNullValues": analysis["rowsWithNullValues"],
+        "variableTypes": analysis["variableTypes"],
+    }
+
+
+def test_analyze_resource_detailed_leaves_out_a_field_missing_from_the_header():
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "integer"},
+                {"name": "count", "type": "integer"},
+            ]
+        }
+    )
+    resource = TableResource(data=[["id"], ["1"], ["2"]], schema=schema)
+    assert _summary(resource.analyze(detailed=True)) == {
+        "fieldStats": ["id"],
+        "rowsWithNullValues": 0,
+        "variableTypes": {"integer": 1},
+    }
+
+
+def test_analyze_resource_detailed_leaves_out_a_label_the_schema_does_not_declare():
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "type": "integer"},
+                {"name": "count", "type": "integer"},
+            ],
+            "fieldsMatch": "partial",
+        }
+    )
+    data = [["id", "count", "extra"], ["1", "3", "x"], ["2", "4", "y"]]
+    resource = TableResource(data=data, schema=schema)
+    assert _summary(resource.analyze(detailed=True)) == {
+        "fieldStats": ["id", "count"],
+        "rowsWithNullValues": 0,
+        "variableTypes": {"integer": 2},
+    }
