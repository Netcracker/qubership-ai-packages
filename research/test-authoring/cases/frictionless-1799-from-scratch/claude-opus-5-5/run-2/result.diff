+# Under `exact`, a header mismatch is reported once, by the header; the rows
+# are then checked against the header, so a row that matches it reports
+# nothing and a row that doesn't still reports its cells.
+
+
+def test_resource_validate_fields_match_exact_extra_label_still_reports_a_longer_row():
+    source = [["name", "id"], ["english", "1"], ["french", "2", "x"]]
+    report = _validate_fields_match(["name"], "exact", source)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 2, "", "extra-label"],
+        [3, 3, "", "extra-cell"],
+    ]
+
+
+def test_resource_validate_fields_match_exact_extra_label_reports_its_missing_cell():
+    source = [["name", "id"], ["english"]]
+    report = _validate_fields_match(["name"], "exact", source)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 2, "", "extra-label"],
+        [2, 2, "id", "missing-cell"],
+    ]
+
+
+def test_resource_validate_fields_match_exact_missing_label_still_reports_a_shorter_row():
+    source = [["name", "id"], ["english", "1"], ["french"]]
+    report = _validate_fields_match(["name", "id", "extra"], "exact", source)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 3, "extra", "missing-label"],
+        [3, 2, "id", "missing-cell"],
+    ]
+
+
+def test_resource_validate_fields_match_exact_missing_label_reports_its_cell_as_extra():
+    source = [["name", "id"], ["english", "1", "x"]]
+    report = _validate_fields_match(["name", "id", "extra"], "exact", source)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == [
+        [None, 3, "extra", "missing-label"],
+        [2, 3, "", "extra-cell"],
+    ]
+
+
+# Integrity checks on a field the header lacks: the missing label is the only
+# error for that field, while the checks on the other fields still run.
+
+
+@pytest.mark.parametrize(
+    "fields_match, expected",
+    [
+        ("exact", [[None, 2, "name", "missing-label"], [3, 1, "id", "unique-error"]]),
+        ("superset", [[3, 1, "id", "unique-error"]]),
+    ],
+)
+def test_resource_validate_fields_match_unique_skips_a_field_the_header_lacks(
+    fields_match, expected
+):
+    schema = Schema.from_descriptor(
+        {
+            "fields": [
+                {"name": "id", "constraints": {"unique": True}},
+                {"name": "name", "constraints": {"unique": True}},
+            ],
+            "fieldsMatch": fields_match,
+        }
+    )
+    resource = TableResource([["id"], ["1"], ["1"]], schema=schema)
+    report = frictionless.validate(resource)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+@pytest.mark.parametrize(
+    "primary_key, expected",
+    [
+        pytest.param(
+            ["name"],
+            [[None, 2, "name", "missing-label"]],
+            id="on a field the header lacks",
+        ),
+        pytest.param(
+            ["id"],
+            [[None, 2, "name", "missing-label"], [3, None, None, "primary-key"]],
+            id="on a field the header carries",
+        ),
+    ],
+)
+def test_resource_validate_fields_match_exact_primary_key_needs_its_labels(
+    primary_key, expected
+):
+    schema = Schema.from_descriptor(
+        {"fields": [{"name": "id"}, {"name": "name"}], "primaryKey": primary_key}
+    )
+    resource = TableResource([["id"], ["1"], ["1"]], schema=schema)
+    report = frictionless.validate(resource)
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
+@pytest.mark.parametrize(
+    "fields_match, expected",
+    [
+        ("exact", [[None, 3, "ref", "missing-label"], [3, None, None, "foreign-key"]]),
+        ("superset", [[3, None, None, "foreign-key"]]),
+    ],
+)
+def test_resource_validate_fields_match_foreign_key_skips_a_field_the_header_lacks(
+    fields_match, expected
+):
+    # `parent` is the control: its dangling reference is still reported.
+    schema = Schema.from_descriptor(
+        {
+            "fields": [{"name": "id"}, {"name": "parent"}, {"name": "ref"}],
+            "fieldsMatch": fields_match,
+            "foreignKeys": [
+                {"fields": ["parent"], "reference": {"resource": "", "fields": ["id"]}},
+                {"fields": ["ref"], "reference": {"resource": "", "fields": ["id"]}},
+            ],
+        }
+    )
+    source = [["id", "parent"], ["1", "1"], ["2", "9"]]
+    report = frictionless.validate(TableResource(source, schema=schema))
+    assert report.flatten(["rowNumber", "fieldNumber", "fieldName", "type"]) == expected
+
+
 def test_resource_fields_match_reads_cells_by_name():
