+            @NullMarked
+            interface Test<K, V extends @Nullable Object> {
+              Map<? extends K, ? extends @NonNull V> loadNonNull(Set<? extends K> keys);
+              default CompletableFuture<? extends Map<? extends K, ? extends @NonNull V>> asyncLoadNonNull(
+                  Set<? extends K> keys) {
+                return CompletableFuture.supplyAsync(() -> loadNonNull(keys));
+              }
+              Map<? extends K, ? extends V> load();
+              default Map<? extends K, ? extends V> pass() {
+                return load();
+              }
+            }
+            """)
