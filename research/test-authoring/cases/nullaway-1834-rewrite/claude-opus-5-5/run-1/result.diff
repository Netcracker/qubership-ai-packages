+  @Test
+  public void aWildcardBoundedByATypeVariableRejectsAnActualOnlyWhereItAdmitsNullAndTheVariableDoesNot() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import java.util.Map;
+            import java.util.concurrent.CompletableFuture;
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            class Test {
+              static class Box<E extends @Nullable Object> {}
+              static class NonNullHolder<T> {
+                void takeExtendsT(Box<? extends T> b) {}
+                <S extends @Nullable T> void nullableBound(Box<S> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<S> cannot be converted to Box<? extends T>
+                  takeExtendsT(b);
+                }
+                <S extends T> void nonNullBound(Box<S> b) {
+                  takeExtendsT(b);
+                }
+              }
+              static class NullableHolder<T extends @Nullable Object> {
+                void takeExtendsT(Box<? extends T> b) {}
+                <S extends T> void boundedByT(Box<S> b) {
+                  takeExtendsT(b);
+                }
+                void nullableUse(Box<@Nullable T> b) {
+                  // BUG: Diagnostic contains: incompatible types: Box<@Nullable T> cannot be converted to Box<? extends T>
+                  takeExtendsT(b);
+                }
+              }
+              static <T extends @Nullable Object> Box<? extends T> sameVariable(Box<T> b) {
+                return b;
+              }
+              interface Loader<K, V extends @Nullable Object> {
+                V load();
+                Map<? extends K, ? extends V> loadAll();
+                default CompletableFuture<? extends V> sameVariableUnderInference() {
+                  return CompletableFuture.supplyAsync(() -> load());
+                }
+                default Map<? extends K, ? extends V> capturedActual() {
+                  return loadAll();
+                }
+              }
+            }
+            """)
+        .doTest();
+  }
