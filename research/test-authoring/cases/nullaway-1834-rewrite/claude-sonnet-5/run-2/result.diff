+              static class Box<E extends @Nullable Object> {}
+              static <T extends @Nullable Object> Box<? extends T> aTypeVariableItselfMeets(Box<T> b) {
+                return b;
+              }
+              interface AsyncLoader<V extends @Nullable Object> {
+                V load();
+                default CompletableFuture<? extends V> aLoadUnderInferenceMeets() {
+                  return CompletableFuture.supplyAsync(() -> load());
