+  @Test
+  public void aNullableWrittenOnATypeVariableUseFailsAWildcardBoundedByThatVariable() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import java.util.concurrent.CompletableFuture;
