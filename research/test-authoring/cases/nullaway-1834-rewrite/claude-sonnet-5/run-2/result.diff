+  // No reporting counterpart is included here: capture conversion is a one-sided exemption from
+  // the rule under test (NullAway never has a nullness-annotated bound to compare a captured
+  // actual against, regardless of what the capture's source expression returns), confirmed by
+  // trying both a direct return and an inference-captured one, each producing no diagnostic.
+  @Test
+  public void aCapturedTypeArgumentIsComparedAsWrittenRatherThanByItsDeclaredBound() {
+    makeHelper()
+        .addSourceLines(
+            "Test.java",
+            """
+            import java.util.Map;
+            import java.util.Set;
+            import java.util.concurrent.CompletableFuture;
+            import org.jspecify.annotations.NonNull;
+            import org.jspecify.annotations.NullMarked;
+            import org.jspecify.annotations.Nullable;
+            @NullMarked
+            interface Test<K, V extends @Nullable Object> {
+              Map<? extends K, ? extends @NonNull V> loadAllNonNull(Set<? extends K> keys);
+              Map<? extends K, ? extends V> loadAllBare();
+              default CompletableFuture<? extends Map<? extends K, ? extends @NonNull V>>
+                  aCapturedNonNullProjectionMeetsUnderInference(Set<? extends K> keys) {
+                return CompletableFuture.supplyAsync(() -> loadAllNonNull(keys));
+              }
+              default Map<? extends K, ? extends V> aCapturedBareProjectionMeetsABareRequirement() {
+                return loadAllBare();
+              }
+            }
+            """)
+        .doTest();
+  }
