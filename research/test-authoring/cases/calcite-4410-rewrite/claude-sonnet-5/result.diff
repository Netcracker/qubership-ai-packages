+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>:
+   * a USING column written in lower case on both sides of the join expands to a COALESCE of
+   * the two sides, even though the catalog stores the column in upper case. Before the fix,
+   * the lookup of the USING name among each side's field names was always case-sensitive and
+   * found no match on either side, failing an internal assertion. */
+  @Test void testJoinUsingCommonColumnMatchedCaseInsensitivelyWhenBothLowercase() {
+    sql("select deptno from emp join dept using (deptno)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>:
+   * a select item is recognized as the USING column that it refers to even though the two
+   * spell its name with different case, and the COALESCE is given the select item's own case
+   * as its alias (not the USING clause's). Before the fix, the outer comparison between the
+   * select item and the USING name was case-sensitive, so the column was not recognized as
+   * common and {@code DEPTNO} resolved as an ambiguous, unqualified reference to both
+   * {@code EMP.DEPTNO} and {@code DEPT.DEPTNO}. */
+  @Test void testJoinUsingCommonColumnMatchedCaseInsensitivelyWhenSelectItemIsUppercase() {
+    sql("select DEPTNO from emp join dept using (deptno)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>:
+   * the mirror of the previous case, with the upper case spelling in the USING clause instead
+   * of the select item; the column is still recognized as common and keeps the select item's
+   * own (lower) case as the alias. Before the fix this also resolved {@code deptno} as an
+   * ambiguous reference. */
+  @Test void testJoinUsingCommonColumnMatchedCaseInsensitivelyWhenUsingClauseIsUppercase() {
+    sql("select deptno from emp join dept using (DEPTNO)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`DEPTNO`)");
+  }
