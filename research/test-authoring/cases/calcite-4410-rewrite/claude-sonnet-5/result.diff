+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>.
+   *
+   * <p>Before the fix, a common column written in the USING list was looked up, in the row
+   * type of each side of the join, with a case-sensitive {@code List.contains}, regardless of
+   * the configured name matcher; with a case-insensitive catalog and identifiers left in their
+   * original case (so that the written column name does not already equal the catalog's
+   * upper-case field name), that lookup silently failed on both sides, tripping the {@code
+   * assert qualifiedNode.size() == 2} a few lines below. */
+  @Test void testJoinUsingCommonColumnCaseInsensitive() {
+    sql("select deptno from emp join dept using (deptno)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
