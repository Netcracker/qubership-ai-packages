+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>.
+   * A common column named in upper case in the SELECT clause is matched,
+   * case-insensitively, against a USING column named in lower case; the
+   * COALESCE operands follow the spelling of the USING clause, and the
+   * result column keeps the spelling of the SELECT item. */
+  @Test void testJoinUsingCommonColumnMatchesCaseInsensitively() {
+    sql("select DEPTNO from emp join dept using (deptno)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>.
+   * The mirror of {@link #testJoinUsingCommonColumnMatchesCaseInsensitively()}: the
+   * SELECT item is now the one in lower case and the USING column the one in
+   * upper case, showing that the result column always keeps the spelling of
+   * the SELECT item and not of the USING clause. */
+  @Test void testJoinUsingCommonColumnAliasKeepsSelectItemCasing() {
+    sql("select deptno from emp join dept using (DEPTNO)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`DEPTNO`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>.
+   * A common column of a NATURAL JOIN, selected unqualified, is coalesced
+   * rather than rejected as ambiguous, even with the default, case-sensitive
