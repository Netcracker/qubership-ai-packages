+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>.
+   *
+   * <p>Before the fix, the common column named in the USING list was matched against each
+   * SELECT identifier with a case-sensitive {@code String.equals}, regardless of the
+   * configured name matcher; with a case-insensitive catalog, a SELECT identifier spelled in
+   * another case than the USING list failed to match, fell through to ordinary (unqualified)
+   * resolution, and was reported as ambiguous because both joined tables have a DEPTNO column.
+   * The two cases below write the mismatch in each direction, because the alias of the
+   * resulting {@code COALESCE} takes the case of the SELECT identifier, not of the USING
+   * list, so the two directions produce different expected output. */
+  @Test void testJoinUsingCommonColumnCaseInsensitiveSelectUppercase() {
+    sql("select DEPTNO from emp join dept using (deptno)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
+
+  @Test void testJoinUsingCommonColumnCaseInsensitiveUsingUppercase() {
+    sql("select deptno from emp join dept using (DEPTNO)")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
