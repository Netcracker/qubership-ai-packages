+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive is false</a>.
+   * The common column of a USING join is matched by name regardless of which side, if
+   * any, differs in letter case from the USING clause; the resulting column takes the
+   * letter case of the select item. */
+  @ParameterizedTest(name = "{0}")
+  @MethodSource("joinUsingCommonColumnCaseCombinations")
+  void testJoinUsingCommonColumnMatchedIgnoringCase(String description,
+      String selectColumn, String usingColumn, String expectedColumnName) {
+    sql("select " + selectColumn + " from emp join dept using (" + usingColumn + ")")
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .type("RecordType(INTEGER NOT NULL " + expectedColumnName + ") NOT NULL");
+  }
+
+  // description, case of the select item, case of the USING column, resulting column name
+  static Stream<Arguments> joinUsingCommonColumnCaseCombinations() {
+    return Stream.of(
+        arguments("select item and USING column both upper case",
+            "DEPTNO", "DEPTNO", "DEPTNO"),
+        arguments("select item and USING column both lower case",
+            "deptno", "deptno", "deptno"),
+        arguments("select item upper case, USING column lower case",
+            "DEPTNO", "deptno", "DEPTNO"),
+        arguments("select item lower case, USING column upper case",
+            "deptno", "DEPTNO", "deptno"));
+  }
+
