+  /** Returns a fixture that matches names case-insensitively, keeps them in
+   * the case they are written, and expands identifiers, so that
+   * {@link SqlValidatorFixture#rewritesTo} shows how a common column of
+   * {@code JOIN ... USING} or {@code NATURAL JOIN} was expanded. */
+  private SqlValidatorFixture sqlCaseInsensitiveExpanded(String sql) {
+    return sql(sql)
+        .withCaseSensitive(false)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .withValidatorIdentifierExpansion(true);
+  }
+
+  /** A common column written in the case of the catalog is expanded the same
+   * way whether names match case-sensitively or not. */
+  @Test void testJoinUsingCaseInsensitiveCommonColumnInCatalogCaseIsCoalesced() {
+    sqlCaseInsensitiveExpanded("select DEPTNO from emp join dept using (DEPTNO)")
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`DEPTNO`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive
+   * is false</a>. */
+  @Test void testJoinUsingCaseInsensitiveCommonColumnInOtherCaseIsCoalesced() {
+    sqlCaseInsensitiveExpanded("select deptno from emp join dept using (deptno)")
