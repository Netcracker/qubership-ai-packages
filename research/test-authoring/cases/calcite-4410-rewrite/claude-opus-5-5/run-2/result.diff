+  /** Returns a fixture that validates {@code sql} with identifier expansion,
+   * keeps every identifier in the case it is written, and matches names
+   * case-sensitively or case-insensitively. */
+  private SqlValidatorFixture sqlWithUnchangedCasing(String sql,
+      boolean caseSensitive) {
+    return sql(sql)
+        .withCaseSensitive(caseSensitive)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .withValidatorIdentifierExpansion(true);
+  }
+
+  @Test void testCaseInsensitiveJoinUsingResolvesCommonColumnWrittenAsInTable() {
+    sqlWithUnchangedCasing("select DEPTNO from EMP join DEPT using (DEPTNO)", false)
+        .type("RecordType(INTEGER NOT NULL DEPTNO) NOT NULL");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive
+   * is false</a>. The query used to fail with "Column 'deptno' is
+   * ambiguous". */
+  @Test void testCaseInsensitiveJoinUsingResolvesSelectItemInOtherCaseThanUsing() {
+    sqlWithUnchangedCasing("select deptno from EMP join DEPT using (DEPTNO)", false)
+        .type("RecordType(INTEGER NOT NULL deptno) NOT NULL");
+  }
+
+  @Test void testCaseSensitiveJoinUsingRejectsSelectItemInOtherCaseThanUsing() {
+    sqlWithUnchangedCasing("select ^deptno^ from EMP join DEPT using (DEPTNO)", true)
+        .fails("Column 'deptno' not found in any table; "
+            + "did you mean 'DEPTNO', 'DEPTNO'\\?");
+  }
+
