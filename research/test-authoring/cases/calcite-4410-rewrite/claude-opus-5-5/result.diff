+  /** Returns a fixture that matches names case-insensitively, keeps the
+   * case of identifiers as written, and expands identifiers, so that a
+   * common column of a join can be spelled differently from the catalog. */
+  private SqlValidatorFixture sqlCaseInsensitiveKeepingCase(String sql) {
+    return sql(sql)
+        .withCaseSensitive(false)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .withValidatorIdentifierExpansion(true);
+  }
