+  /** Returns a fixture that matches names case-insensitively, keeps the case
+   * of identifiers as written, and expands identifiers, so that
+   * {@link SqlValidatorFixture#rewritesTo} shows how a common column of
+   * {@code JOIN ... USING} or {@code NATURAL JOIN} was expanded. */
+  private SqlValidatorFixture sqlCaseInsensitive(String sql) {
+    return sql(sql)
+        .withCaseSensitive(false)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED);
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive
+   * is false</a>.
+   *
+   * <p>The common column is spelled as the tables spell it, so it expands the
+   * same way with case-sensitive matching. */
+  @Test void testJoinUsingCaseInsensitiveExpandsColumnSpelledAsInTable() {
+    sqlCaseInsensitive("select DEPTNO from emp join dept using (DEPTNO)")
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`DEPTNO`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]</a>.
+   *
+   * <p>The select list and the USING clause spell the column alike, but not
+   * as the tables do. */
+  @Test void testJoinUsingCaseInsensitiveExpandsColumnSpelledUnlikeTable() {
+    sqlCaseInsensitive("select deptno from emp join dept using (deptno)")
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]</a>.
+   *
+   * <p>The expanded column takes its alias from the select list, not from the
+   * USING clause. */
+  @Test void testJoinUsingCaseInsensitiveAliasesColumnAsSelectListSpellsIt() {
+    sqlCaseInsensitive("select DEPTNO from emp join dept using (deptno)")
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`deptno`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]</a>.
+   *
+   * <p>As {@link #testJoinUsingCaseInsensitiveAliasesColumnAsSelectListSpellsIt},
+   * with the spellings of the select list and the USING clause swapped. */
+  @Test void testJoinUsingCaseInsensitiveAliasesLowerCaseColumnAsSelectListSpellsIt() {
+    sqlCaseInsensitive("select deptno from emp join dept using (DEPTNO)")
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept` USING (`DEPTNO`)");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]</a>.
+   *
+   * <p>With case-sensitive matching, a USING column spelled unlike the select
+   * list does not match it. The tables are spelled as the catalog spells them,
+   * so that only the column fails to resolve. */
+  @Test void testJoinUsingCaseSensitiveDoesNotMatchColumnSpelledDifferently() {
+    sql("select ^deptno^ from EMP join DEPT using (DEPTNO)")
+        .withCaseSensitive(true)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED)
+        .fails("Column 'deptno' not found in any table; did you mean 'DEPTNO', 'DEPTNO'\\?");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]</a>.
+   *
+   * <p>A common column of NATURAL JOIN expands as one of USING does. */
+  @Test void testNaturalJoinExpandsCommonColumn() {
