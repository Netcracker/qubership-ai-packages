+  /** Returns a fixture that expands identifiers and keeps every identifier
+   * in the case it is written in, so that {@code deptno} reaches the name
+   * matcher in lower case while the catalog spells the column {@code DEPTNO}.
+   *
+   * <p>Used by the tests for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]
+   * JOIN with USING does not match the appropriate columns when caseSensitive
+   * is false</a>. */
+  private SqlValidatorFixture sqlExpandedInWrittenCase(String sql) {
+    return sql(sql)
+        .withValidatorIdentifierExpansion(true)
+        .withQuotedCasing(Casing.UNCHANGED)
+        .withUnquotedCasing(Casing.UNCHANGED);
+  }
+
+  @Test void testJoinUsingCaseInsensitiveExpandsCommonColumnInCatalogCase() {
+    sqlExpandedInWrittenCase("select DEPTNO from EMP join DEPT using (DEPTNO)")
+        .withCaseSensitive(false)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `EMP`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `DEPT` USING (`DEPTNO`)");
+  }
+
+  @Test void testJoinUsingCaseInsensitiveExpandsCommonColumnInOtherCase() {
+    sqlExpandedInWrittenCase("select deptno from EMP join DEPT using (deptno)")
+        .withCaseSensitive(false)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `EMP`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `DEPT` USING (`deptno`)");
+  }
+
+  @Test void testJoinUsingCaseInsensitiveExpandsColumnSpelledOtherwiseInUsing() {
+    sqlExpandedInWrittenCase("select DEPTNO from EMP join DEPT using (deptno)")
+        .withCaseSensitive(false)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `EMP`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `DEPT` USING (`deptno`)");
+  }
+
+  /** The expanded column takes its alias from the select list, not from the
+   * USING list. */
+  @Test void testJoinUsingCaseInsensitiveAliasesCommonColumnAsSelectListSpellsIt() {
+    sqlExpandedInWrittenCase("select deptno from EMP join DEPT using (DEPTNO)")
+        .withCaseSensitive(false)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `EMP`\n"
+            + "INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `DEPT` USING (`DEPTNO`)");
+  }
+
+  @Test void testJoinUsingCaseSensitiveDoesNotMatchCommonColumnInOtherCase() {
+    sqlExpandedInWrittenCase("select ^deptno^ from EMP join DEPT using (DEPTNO)")
+        .withCaseSensitive(true)
+        .fails("Column 'deptno' not found in any table.*");
+  }
+
+  @Test void testNaturalJoinCaseSensitiveExpandsCommonColumn() {
+    sqlExpandedInWrittenCase("select DEPTNO from EMP natural join DEPT")
+        .withCaseSensitive(true)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `DEPTNO`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `EMP`\n"
+            + "NATURAL INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `DEPT`");
+  }
+
+  @Test void testNaturalJoinCaseInsensitiveExpandsCommonColumnInOtherCase() {
+    sqlExpandedInWrittenCase("select deptno from EMP natural join DEPT")
+        .withCaseSensitive(false)
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `EMP`\n"
+            + "NATURAL INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `DEPT`");
+  }
+
