+            + "NATURAL INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept`");
+  }
+
+  /** Test case for
+   * <a href="https://issues.apache.org/jira/browse/CALCITE-7051">[CALCITE-7051]</a>. */
+  @Test void testNaturalJoinCaseInsensitiveExpandsColumnSpelledUnlikeTable() {
+    sqlCaseInsensitive("select deptno from emp natural join dept")
+        .rewritesTo("SELECT COALESCE(`EMP`.`DEPTNO`, `DEPT`.`DEPTNO`) AS `deptno`\n"
+            + "FROM `CATALOG`.`SALES`.`EMP` AS `emp`\n"
+            + "NATURAL INNER JOIN `CATALOG`.`SALES`.`DEPT` AS `dept`");
+  }
