+  /*
+   * A null that is only an operand of == or != is not a value the SpEL expression can produce, so
+   * it does not make a @Value field possibly uninitialized. In each test below, the reported field
+   * differs from the silent one only in returning null from a branch.
+   */
+  @Test
+  public void springValueNullAfterNotEqualsIsNotAPossibleValue() {
+    addSpringValueAnnotationStub(defaultCompilationHelper)
+        .addSourceLines(
+            "Test.java",
+            """
+            package com.uber;
+            import org.springframework.beans.factory.annotation.Value;
+            class Test {
+              @Value("#{bean != null ? bean.name : 'default'}")
+              String checked;
+              @Value("#{bean != null ? null : 'default'}")
+              // BUG: Diagnostic contains: @NonNull field 'checkedReturningNull' not initialized
+              String checkedReturningNull;
+            }
+            """)
+        .doTest();
+  }
+
