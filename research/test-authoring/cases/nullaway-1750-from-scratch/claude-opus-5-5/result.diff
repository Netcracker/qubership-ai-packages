+  /**
+   * Checks a class with two Spring {@code @Value} fields: {@code comparisonOnly}, whose SpEL
+   * expression mentions {@code null} only as a comparison operand and must not be reported, and
+   * {@code nullResult}, whose expression can evaluate to {@code null} and must be reported as not
+   * initialized.
+   *
+   * @param comparisonOnlySpel the {@code @Value} string of {@code comparisonOnly}
+   * @param nullResultSpel the {@code @Value} string of {@code nullResult}
+   */
+  private void checkOnlyNullResultSpelIsReported(String comparisonOnlySpel, String nullResultSpel) {
+    addSpringValueAnnotationStub(defaultCompilationHelper)
+        .addSourceLines(
+            "SpelNullComparison.java",
+            """
+            package com.uber;
+            import org.springframework.beans.factory.annotation.Value;
+            class SpelNullComparison {
+              @Value("%s")
+              String comparisonOnly;
+              @Value("%s")
+              // BUG: Diagnostic contains: @NonNull field 'nullResult' not initialized
+              String nullResult;
+            }
+            """
+                .formatted(comparisonOnlySpel, nullResultSpel))
+        .doTest();
+  }
+
+  @Test
+  public void springValueSpelWithBeanNotEqualsNullIsNullableOnlyWithANullResult() {
+    checkOnlyNullResultSpelIsReported(
+        "#{bean != null ? bean.name : 'default'}", "#{bean != null ? null : 'default'}");
+  }
+
+  @Test
+  public void springValueSpelWithBeanEqualsNullIsNullableOnlyWithANullResult() {
