{
  "id": 7,
  "type": "piechart",
  "title": "Requests by status class",
  "description": "Share of responses by HTTP status class.",
  "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
  },
  "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
  },
  "fieldConfig": {
    "defaults": {
      "unit": "reqps",
      "decimals": 1
    }
  },
  "options": {
    "reduceOptions": {
      "values": false,
      "calcs": [
        "lastNotNull"
      ]
    },
    "pieType": "donut",
    "displayLabels": [
      "percent"
    ],
    "legend": {
      "showLegend": true,
      "displayMode": "list",
      "placement": "right"
    }
  },
  "targets": [
    {
      "refId": "A",
      "expr": "sum by (status_class) (rate(http_requests_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval]))",
      "legendFormat": "{{status_class}}"
    }
  ]
}
