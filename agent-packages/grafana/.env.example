# Copy to .env and fill in. .env is gitignored; never commit a token.
#
# Grafana is the only address you need. Datasource URLs and UIDs for
# VictoriaMetrics, VictoriaLogs, Tempo, and Pyroscope are read from
# GET /api/datasources, and queries are proxied through POST /api/ds/query.
#
# Skip both variables entirely if the `grafana` MCP server is configured;
# it already holds the address and the credential.

GRAFANA_URL=https://grafana.example.com
GRAFANA_TOKEN=

# Optional. Set these only to query a VictoriaMetrics backend directly,
# bypassing Grafana. Consumed by the VictoriaMetrics/skills query skills.
VM_METRICS_URL=
VM_LOGS_URL=
VM_TRACES_URL=

# curl config file holding an auth header, for remote VictoriaMetrics.
# Leave unset for a local instance.
VM_CURL_CONFIG=
