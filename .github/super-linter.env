# Local overrides on top of .github/linters/super-linter.env (from netcracker/.github).
# Loaded by .github/workflows/super-linter.yaml.

# netcracker/.github ships its markdownlint config as `.markdownlint.json`,
# but super-linter v8's default MARKDOWN_CONFIG_FILE is `.markdown-lint.yml`,
# so the file is otherwise ignored and rules like `MD041: false` never apply.
MARKDOWN_CONFIG_FILE=.markdownlint.json

# Skip raw research artefacts (LLM phase prompts/results, seed drafts, the A/B
# trial's input and its two drafts, a case's model output and its controls) and the
# deep-research brief/report, including the *.ru.md originals kept verbatim, and every file
# a session wrote under a case's results/ directory — they are provenance transcripts, not
# reformatted. research/README.md is still linted.
# A Workflow script is the body of an async function: it exports `meta` and ends in a top-level `return`, which no
# ESLint source type accepts. tests/workflow-scripts, run by `make test`, compiles each one the way the runtime does.
FILTER_REGEX_EXCLUDE=research/.*/(phase[^/]*|seed_[^/]*|prompt[^/]*|results?[^/]*|results/.*|controls/.*|deep-research[^/]*|trial/(facts|control|treatment))\.md|(^|/)(\.agents/|\.codex/|\.claude/(apm-hooks\.json|settings\.json|rules/|skills/)|\.cursor/(hooks\.json|rules/))|\.apm/skills/[^/]+/workflow/[^/]+\.js$
